@page "/company/login"
@model KnOwl.ControlPlaneHost.Sample.Pages.Company.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in - Northstar Contract Console</title>
    <style>
        :root {
            color-scheme: light;
            --page: #eef3f1;
            --ink: #10201d;
            --muted: #60726d;
            --panel: #fffaf1;
            --panel-strong: #173d36;
            --panel-soft: #e8efe9;
            --line: #c9d7d2;
            --action: #b45309;
            --action-hover: #92400e;
            --accent: #0f766e;
            --danger: #9f1239;
            --shadow: 0 28px 80px rgba(24, 48, 43, .18);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                color-scheme: dark;
                --page: #0d1715;
                --ink: #f8faf7;
                --muted: #b6c9c2;
                --panel: #182420;
                --panel-strong: #dff7ee;
                --panel-soft: #12201d;
                --line: #2b423c;
                --action: #f59e0b;
                --action-hover: #fbbf24;
                --accent: #5eead4;
                --danger: #fda4af;
                --shadow: 0 30px 90px rgba(0, 0, 0, .46);
            }
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            background:
                linear-gradient(135deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent 32%),
                var(--page);
            color: var(--ink);
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: 15px;
        }

        .signin-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(320px, .92fr) minmax(360px, 520px);
        }

        .signin-story {
            display: grid;
            align-content: space-between;
            min-height: 100vh;
            background:
                linear-gradient(180deg, color-mix(in srgb, var(--panel-strong) 88%, #000000), var(--panel-strong));
            color: #f9fafb;
            padding: clamp(28px, 5vw, 56px);
        }

        .brand-lockup {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 900;
            letter-spacing: .01em;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .24);
            border-radius: 10px;
            background: rgba(255, 255, 255, .1);
            color: #fcd34d;
            font-weight: 950;
        }

        .story-copy {
            max-width: 680px;
            padding: 56px 0;
        }

        .story-copy p:first-child {
            margin: 0 0 12px;
            color: #99f6e4;
            font-size: .78rem;
            font-weight: 900;
            letter-spacing: .11em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            max-width: 760px;
            font-size: clamp(2.45rem, 6vw, 5.8rem);
            line-height: .95;
            letter-spacing: -.035em;
        }

        .story-copy p:last-child {
            max-width: 560px;
            margin: 22px 0 0;
            color: #d9f0e9;
            font-size: 1rem;
            line-height: 1.7;
        }

        .story-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .story-metric {
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 10px;
            background: rgba(255, 255, 255, .07);
            padding: 14px;
        }

        .story-metric strong,
        .story-metric span {
            display: block;
        }

        .story-metric strong {
            color: #ffffff;
            font-size: 1.15rem;
        }

        .story-metric span {
            margin-top: 3px;
            color: #b7d9d0;
            font-size: .78rem;
        }

        .signin-panel-zone {
            display: grid;
            place-items: center;
            min-height: 100vh;
            padding: clamp(20px, 4vw, 48px);
        }

        .signin-panel {
            width: min(100%, 430px);
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--panel);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .signin-panel-header {
            border-bottom: 1px solid var(--line);
            background:
                linear-gradient(90deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent),
                var(--panel-soft);
            padding: 22px;
        }

        .signin-panel-header p {
            margin: 0;
            color: var(--accent);
            font-size: .74rem;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .signin-panel-header h2 {
            margin: 7px 0 0;
            color: var(--ink);
            font-size: 1.45rem;
            line-height: 1.2;
        }

        .signin-panel-body {
            display: grid;
            gap: 18px;
            padding: 22px;
        }

        .security-note {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .identity-summary {
            display: grid;
            gap: 9px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: color-mix(in srgb, var(--panel-soft) 72%, transparent);
            padding: 14px;
        }

        .identity-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .identity-row span {
            color: var(--muted);
        }

        .identity-row strong {
            color: var(--ink);
            text-align: right;
        }

        .signin-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 46px;
            border: 1px solid var(--action);
            border-radius: 8px;
            background: var(--action);
            color: #ffffff;
            padding: 0 16px;
            font-weight: 900;
            text-decoration: none;
        }

        .signin-button:hover {
            border-color: var(--action-hover);
            background: var(--action-hover);
            color: #ffffff;
            text-decoration: none;
        }

        .signin-footer {
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: .82rem;
            line-height: 1.55;
            padding: 16px 22px 20px;
        }

        .signin-footer strong {
            color: var(--ink);
        }

        @@media (max-width: 920px) {
            .signin-shell {
                grid-template-columns: 1fr;
            }

            .signin-story {
                min-height: auto;
                padding-bottom: 28px;
            }

            .story-copy {
                padding: 44px 0 30px;
            }

            .story-metrics {
                grid-template-columns: 1fr;
            }

            .signin-panel-zone {
                min-height: auto;
            }
        }
    </style>
</head>
<body>
    <main class="signin-shell">
        <section class="signin-story" aria-label="Northstar Contract Console">
            <div class="brand-lockup">
                <div class="brand-mark" aria-hidden="true">N</div>
                <span>Northstar Contract Console</span>
            </div>

            <div class="story-copy">
                <p>Contract operations</p>
                <h1>Secure access for release teams.</h1>
                <p>
                    Sign in to review contract catalogs, approve payload versions, and coordinate
                    artifact delivery across runtime environments.
                </p>
            </div>

            <div class="story-metrics" aria-label="Console highlights">
                <div class="story-metric">
                    <strong>Entra ID</strong>
                    <span>Federated sign-in</span>
                </div>
                <div class="story-metric">
                    <strong>WolfAuth</strong>
                    <span>Authentication gateway</span>
                </div>
                <div class="story-metric">
                    <strong>Host UI</strong>
                    <span>Custom login shell</span>
                </div>
            </div>
        </section>

        <section class="signin-panel-zone" aria-label="Sign in form">
            <div class="signin-panel">
                <div class="signin-panel-header">
                    <p>Restricted workspace</p>
                    <h2>Continue with your company identity</h2>
                </div>

                <div class="signin-panel-body">
                    <p class="security-note">
                        This host owns the login experience and delegates authentication to WolfAuth.
                        Your session starts through the configured Entra ID provider.
                    </p>

                    <div class="identity-summary" aria-label="Authentication details">
                        <div class="identity-row">
                            <span>Provider</span>
                            <strong>Microsoft Entra ID</strong>
                        </div>
                        <div class="identity-row">
                            <span>Access</span>
                            <strong>Control Plane</strong>
                        </div>
                    </div>

                    <a class="signin-button" href="@Model.ChallengeUrl">
                        <span>Sign in with Entra ID</span>
                    </a>
                </div>

                <div class="signin-footer">
                    Protected by <strong>WolfAuth</strong>. This page is rendered by the sample host,
                    not by KnOwl's default login screen.
                </div>
            </div>
        </section>
    </main>
</body>
</html>
