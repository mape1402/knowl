<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KnOwl.AspNetCore.Dashboard</PackageId>
    <Title>KnOwl ASP.NET Core Dashboard</Title>
    <PackageType>Dependency</PackageType>
    <Description>Event-driven ASP.NET Core dashboard for KnOwl inbox, outbox, and deferred work diagnostics.</Description>
    <PackageTags>$(PackageTags);aspnetcore;dashboard;diagnostics;outbox;events</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\KnOwl\KnOwl.csproj" />
  </ItemGroup>

</Project>
