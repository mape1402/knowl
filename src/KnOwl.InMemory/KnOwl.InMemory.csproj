<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KnOwl.InMemory</PackageId>
    <Title>KnOwl In-Memory Provider</Title>
    <PackageType>Dependency</PackageType>
    <Description>In-memory inbox store for KnOwl tests, samples, and lightweight local idempotency behavior.</Description>
    <PackageTags>$(PackageTags);in-memory;testing;samples</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ulid" Version="1.4.1" />
    <ProjectReference Include="..\KnOwl\KnOwl.csproj" />
  </ItemGroup>

</Project>
