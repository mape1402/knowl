<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KnOwl.Mule</PackageId>
    <Title>KnOwl Mule Deferred Adapter</Title>
    <PackageType>Dependency</PackageType>
    <Description>Mule durable action adapter for deferring KnOwl inbox execution.</Description>
    <PackageTags>$(PackageTags);mule;deferred;durable-actions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mule.DurableActions" Version="1.4.1" />
    <ProjectReference Include="..\KnOwl\KnOwl.csproj" />
  </ItemGroup>

</Project>
