<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KnOwl.EntityFrameworkCore</PackageId>
    <Title>KnOwl Entity Framework Core Provider</Title>
    <PackageType>Dependency</PackageType>
    <Description>Entity Framework Core storage provider for KnOwl durable inbox and outbox records.</Description>
    <PackageTags>$(PackageTags);entity-framework-core;ef-core;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.18" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.18" />
    <ProjectReference Include="..\KnOwl\KnOwl.csproj" />
  </ItemGroup>

</Project>
