@page
@model IndexModel
@{
    ViewData["Title"] = "Runtime Overview";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Runtime Overview</h1>
        <p class="od-page-subtitle">Operational view of deployed contract artifacts and Control Plane connections.</p>
    </div>
    <div class="event-list-actions">
        <a class="btn btn-primary btn-sm" asp-page="/Artifacts/Index"><i class="bi bi-box-seam"></i> View artifacts</a>
        <a class="btn btn-secondary btn-sm" asp-page="/ControlPlanes/Index"><i class="bi bi-hdd-network"></i> Control planes</a>
    </div>
</div>

<section class="od-grid runtime-metric-grid">
    <article class="od-item-card runtime-metric-card">
        <span class="runtime-metric-value">@Model.TotalArtifacts</span>
        <strong>Total Artifacts</strong>
        <p class="od-item-description">Schemas currently stored by this Runtime.</p>
    </article>
    <article class="od-item-card runtime-metric-card">
        <span class="runtime-metric-value">@Model.EventArtifacts</span>
        <strong>Events</strong>
        <p class="od-item-description">Published event schemas available to consumers.</p>
    </article>
    <article class="od-item-card runtime-metric-card">
        <span class="runtime-metric-value">@Model.CommandArtifacts</span>
        <strong>Commands</strong>
        <p class="od-item-description">Command contracts with request and reply payloads.</p>
    </article>
    <article class="od-item-card runtime-metric-card">
        <span class="runtime-metric-value">@Model.ActiveControlPlanes</span>
        <strong>Ready Control Planes</strong>
        <p class="od-item-description">Connections with active credentials.</p>
    </article>
</section>

<section class="runtime-dashboard-grid">
    <article class="od-panel">
        <div class="od-section-head">
            <div>
                <h2 class="od-section-title">Latest Artifacts</h2>
                <p class="od-page-subtitle">Most recent deployments available in this Runtime.</p>
            </div>
            <a class="btn btn-secondary btn-sm" asp-page="/Artifacts/Index">Open</a>
        </div>
        @if (Model.LatestArtifacts.Count == 0)
        {
            <div class="empty-state">No artifacts have been deployed into this Runtime yet.</div>
        }
        else
        {
            <div class="runtime-list">
                @foreach (var artifact in Model.LatestArtifacts)
                {
                    <a class="runtime-list-row runtime-list-card" asp-page="/Artifacts/View" asp-route-id="@artifact.Id">
                        <span class="type-badge">@artifact.ArtifactType</span>
                        <span>
                            <strong>@artifact.Name</strong>
                            <small>@artifact.Topic @artifact.VersionNumber</small>
                        </span>
                        <time>@artifact.DeployedAtUtc.ToString("u")</time>
                    </a>
                }
            </div>
        }
    </article>

    <article class="od-panel">
        <div class="od-section-head">
            <div>
                <h2 class="od-section-title">Control Planes</h2>
                <p class="od-page-subtitle">Configured sources for incoming releases.</p>
            </div>
            <a class="btn btn-secondary btn-sm" asp-page="/ControlPlanes/Index">Open</a>
        </div>
        @if (Model.ControlPlanes.Count == 0)
        {
            <div class="empty-state">No control planes are registered in this runtime.</div>
        }
        else
        {
            <div class="runtime-list">
                @foreach (var node in Model.ControlPlanes)
                {
                    <div class="runtime-list-row runtime-list-card">
                        <span class="status-dot @(node.IsReady ? "ok" : "warn")"></span>
                        <span>
                            <strong>@node.Name</strong>
                            <small>@node.Key · @node.DistributionMode · @node.Status</small>
                        </span>
                        <span class="muted">@node.CredentialSummary</span>
                    </div>
                }
            </div>
        }
    </article>
</section>

<section class="od-panel runtime-endpoint-panel">
    <div class="od-section-head">
        <div>
            <h2 class="od-section-title">Runtime Endpoints</h2>
            <p class="od-page-subtitle">Use these routes to consume deployed contracts.</p>
        </div>
    </div>
    <div class="endpoint-grid">
        <code>GET /runtime/contracts/artifacts</code>
        <code>GET /runtime/contracts/events/{eventKey}/versions/{versionNumber}</code>
        <code>GET /runtime/contracts/commands/{commandKey}/versions/{versionNumber}</code>
    </div>
</section>
