@page "{id:guid}"
@model KnOwl.Runtime.WebUI.Pages.Artifacts.ViewModel
@{
    ViewData["Title"] = "Artifact Details";
}

@if (Model.Artifact is null)
{
    <section class="od-panel">
        <div class="od-section-head">
            <div>
                <h1 class="od-section-title">Artifact was not found.</h1>
                <p class="od-page-subtitle">The requested artifact does not exist in this Runtime.</p>
            </div>
            <a class="btn btn-secondary btn-sm" asp-page="/Artifacts/Index">Back to artifacts</a>
        </div>
    </section>
}
else
{
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.Artifact.Name</h1>
            <p class="od-page-subtitle">@Model.Artifact.ArtifactType artifact · @Model.Artifact.Topic</p>
        </div>
        <div class="event-list-actions">
            <a class="btn btn-secondary btn-sm" asp-page="/Artifacts/Index">Back</a>
        </div>
    </div>

    <section class="od-panel artifact-detail">
        <div class="detail-grid">
            <div>
                <span>Topic</span>
                <code>@Model.Artifact.Topic</code>
            </div>
            <div>
                <span>Version</span>
                <strong>@Model.Artifact.VersionNumber</strong>
            </div>
            <div>
                <span>Deployed</span>
                <strong>@Model.Artifact.DeployedAtUtc.ToString("u")</strong>
            </div>
            <div>
                <span>Source artifact</span>
                <code>@Model.Artifact.SourceArtifactId</code>
            </div>
            <div>
                <span>Source release</span>
                <code>@Model.Artifact.SourceReleaseId</code>
            </div>
            <div>
                <span>Content hash</span>
                <code>@Model.Artifact.ContentHash</code>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Artifact.Description))
        {
            <p class="artifact-description">@Model.Artifact.Description</p>
        }
    </section>

    <section class="od-panel">
        <div class="od-section-head">
            <div>
                <h2 class="od-section-title">Endpoints</h2>
                <p class="od-page-subtitle">Routes available for consumers.</p>
            </div>
        </div>
        <div class="endpoint-grid">
            <code>GET @Model.ExactEndpoint</code>
            <code>GET @Model.LatestEndpoint</code>
        </div>
    </section>

    <section class="od-panel schema-card">
        <div class="od-section-head">
            <div>
                <h2 class="od-section-title">Payload Schema</h2>
                <p class="od-page-subtitle">Stored artifact snapshot.</p>
            </div>
        </div>
        <pre class="json-panel"><code>@Model.PrettyPayloadSchemaJson</code></pre>
    </section>
}
