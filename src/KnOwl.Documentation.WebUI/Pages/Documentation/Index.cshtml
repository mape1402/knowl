@page "/documentation/spaces"
@model KnOwl.Documentation.WebUI.Pages.Documentation.IndexModel
@{
    ViewData["Title"] = "Documentation";

    string StatusClass(bool isActive)
        => isActive ? "od-status od-status-active" : "od-status od-status-inactive";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Documentation Spaces</h1>
        <p class="od-page-subtitle">Top-level documentation areas with topics, pages, and versions.</p>
    </div>
    <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#newSpaceModal">
        <i class="bi bi-plus-lg"></i> New space
    </button>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="space-search">
        <span>Search spaces</span>
        <input id="space-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, key, or description" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Documentation/Index">Clear</a>
    }
</form>

<section class="od-list-shell">
    @if (Model.Spaces.Count == 0)
    {
        <div class="events-empty-state">
            <i class="bi bi-journal-richtext"></i>
            <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No documentation spaces" : "No matching spaces")</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "Create a space to group product, service, or platform documentation." : "Try a different name, key, or description.")</p>
        </div>
    }
    else
    {
        <div class="documentation-card-grid">
            @foreach (var space in Model.Spaces)
            {
                <article class="documentation-card" data-open-url="@Url.Page("/Documentation/Space", new { spaceId = space.Id })">
                    <div class="documentation-card-top">
                        <div class="documentation-card-title-block">
                            <h2 class="documentation-card-title">@space.Name</h2>
                            <p class="documentation-card-key">@space.Key</p>
                        </div>
                        <span class="@StatusClass(space.IsActive)">@(space.IsActive ? "Active" : "Inactive")</span>
                    </div>
                    <p class="documentation-card-description">@(string.IsNullOrWhiteSpace(space.Description) ? "No description." : space.Description)</p>
                    <div class="documentation-card-footer">
                        <span>Created @space.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

<div class="modal fade" id="newSpaceModal" tabindex="-1" aria-labelledby="newSpaceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateSpace">
                <div class="modal-header">
                    <h5 class="modal-title" id="newSpaceModalLabel">New documentation space</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="NewSpace.Key" class="form-label"></label>
                            <input asp-for="NewSpace.Key" class="form-control" maxlength="120" />
                            <span asp-validation-for="NewSpace.Key" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="NewSpace.Name" class="form-label"></label>
                            <input asp-for="NewSpace.Name" class="form-control" maxlength="200" />
                            <span asp-validation-for="NewSpace.Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="NewSpace.Description" class="form-label"></label>
                            <textarea asp-for="NewSpace.Description" class="form-control" maxlength="1000" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save space</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.ShowNewSpaceModal)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => bootstrap.Modal.getOrCreateInstance(document.getElementById('newSpaceModal')).show());
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
