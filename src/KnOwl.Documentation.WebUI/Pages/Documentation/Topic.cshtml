@page "/documentation/topics/{id:guid}"
@model KnOwl.Documentation.WebUI.Pages.Documentation.TopicModel
@{
    ViewData["Title"] = Model.Topic?.Name ?? "Documentation Topic";

    string StatusClass(bool isActive)
        => isActive ? "od-status od-status-active" : "od-status od-status-inactive";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.Topic?.Name</h1>
        <p class="od-page-subtitle">@Model.Topic?.Key</p>
    </div>
    <div class="event-list-actions">
        @if (Model.Topic is not null)
        {
            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#newPageModal">
                <i class="bi bi-plus-lg"></i> New page
            </button>
        }
        @if (Model.Space is not null)
        {
            <a class="btn btn-secondary btn-sm" asp-page="/Documentation/Space" asp-route-id="@Model.Space.Id"><i class="bi bi-arrow-left"></i> Back</a>
        }
    </div>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="page-search">
        <span>Search pages</span>
        <input id="page-search" name="search" value="@Model.Search" class="form-control" placeholder="Title, key, or description" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Documentation/Topic" asp-route-id="@Model.Topic?.Id">Clear</a>
    }
</form>

<section class="od-list-shell">
    @if (Model.Pages.Count == 0)
    {
        <div class="events-empty-state">
            <i class="bi bi-file-earmark-text"></i>
            <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No pages" : "No matching pages")</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "Create a page for this documentation topic." : "Try a different title, key, or description.")</p>
        </div>
    }
    else
    {
        <div class="od-grid od-documentation-grid">
            @foreach (var docPage in Model.Pages)
            {
                var browseUrl = Model.Space is not null && Model.Topic is not null
                    ? Url.Page("/Documentation/View", new { spaceKey = Model.Space.Key, topicKey = Model.Topic.Key, pageKey = docPage.Key })
                    : Url.Page("/Documentation/Page", new { id = docPage.Id });

                <article class="od-item-card" data-open-url="@browseUrl">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@docPage.Title</h2>
                            <p class="od-item-meta">@docPage.Key</p>
                        </div>
                        <span class="@StatusClass(docPage.IsActive)">@(docPage.IsActive ? "Active" : "Inactive")</span>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(docPage.Description) ? "No description." : docPage.Description)</p>
                    <div class="od-card-footer">
                        <span class="od-card-date">Created @docPage.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <div class="event-list-actions">
                            <a class="btn btn-secondary btn-sm" asp-page="/Documentation/Page" asp-route-id="@docPage.Id">Versions</a>
                            @if (Model.Space is not null && Model.Topic is not null)
                            {
                                <a class="btn btn-secondary btn-sm" asp-page="/Documentation/View" asp-route-spaceKey="@Model.Space.Key" asp-route-topicKey="@Model.Topic.Key" asp-route-pageKey="@docPage.Key">Browse</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (Model.Topic is not null)
{
    <div class="modal fade" id="newPageModal" tabindex="-1" aria-labelledby="newPageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="CreatePage" asp-route-id="@Model.Topic.Id">
                    <div class="modal-header">
                        <h5 class="modal-title" id="newPageModalLabel">New page for @Model.Topic.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="NewPage.Key" class="form-label"></label>
                                <input asp-for="NewPage.Key" class="form-control" maxlength="120" />
                                <span asp-validation-for="NewPage.Key" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NewPage.Title" class="form-label"></label>
                                <input asp-for="NewPage.Title" class="form-control" maxlength="200" />
                                <span asp-validation-for="NewPage.Title" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="NewPage.Description" class="form-label"></label>
                                <textarea asp-for="NewPage.Description" class="form-control" maxlength="1000" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save page</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.ShowNewPageModal)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => bootstrap.Modal.getOrCreateInstance(document.getElementById('newPageModal')).show());
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
