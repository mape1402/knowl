@page "/documentation/spaces/{spaceId:guid}/topics"
@model KnOwl.Documentation.WebUI.Pages.Documentation.SpaceModel
@{
    ViewData["Title"] = Model.Space?.Name ?? "Documentation Space";

    string StatusClass(bool isActive)
        => isActive ? "od-status od-status-active" : "od-status od-status-inactive";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.Space?.Name</h1>
        <p class="od-page-subtitle">@Model.Space?.Key</p>
    </div>
    <div class="event-list-actions">
        @if (Model.Space is not null)
        {
            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#newTopicModal">
                <i class="bi bi-plus-lg"></i> New topic
            </button>
        }
        <a class="btn btn-secondary btn-sm" asp-page="/Documentation/Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="topic-search">
        <span>Search topics</span>
        <input id="topic-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, key, or description" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Documentation/Space" asp-route-spaceId="@Model.Space?.Id">Clear</a>
    }
</form>

<section class="od-list-shell">
    @if (Model.Topics.Count == 0)
    {
        <div class="events-empty-state">
            <i class="bi bi-journal-text"></i>
            <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No topics" : "No matching topics")</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "Create a topic for this documentation space." : "Try a different name, key, or description.")</p>
        </div>
    }
    else
    {
        <div class="documentation-card-grid">
            @foreach (var topic in Model.Topics)
            {
                <article class="documentation-card" data-open-url="@Url.Page("/Documentation/Topic", new { spaceId = Model.Space!.Id, topicId = topic.Id })">
                    <div class="documentation-card-top">
                        <div class="documentation-card-title-block">
                            <h2 class="documentation-card-title">@topic.Name</h2>
                            <p class="documentation-card-key">@topic.Key</p>
                        </div>
                        <span class="@StatusClass(topic.IsActive)">@(topic.IsActive ? "Active" : "Inactive")</span>
                    </div>
                    <p class="documentation-card-description">@(string.IsNullOrWhiteSpace(topic.Description) ? "No description." : topic.Description)</p>
                    <div class="documentation-card-footer">
                        <span>Created @topic.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (Model.Space is not null)
{
    <div class="modal fade" id="newTopicModal" tabindex="-1" aria-labelledby="newTopicModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="CreateTopic" asp-route-spaceId="@Model.Space.Id">
                    <div class="modal-header">
                        <h5 class="modal-title" id="newTopicModalLabel">New topic for @Model.Space.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="NewTopic.Key" class="form-label"></label>
                                <input asp-for="NewTopic.Key" class="form-control" maxlength="120" />
                                <span asp-validation-for="NewTopic.Key" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="NewTopic.Name" class="form-label"></label>
                                <input asp-for="NewTopic.Name" class="form-control" maxlength="200" />
                                <span asp-validation-for="NewTopic.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="NewTopic.Description" class="form-label"></label>
                                <textarea asp-for="NewTopic.Description" class="form-control" maxlength="1000" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save topic</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.ShowNewTopicModal)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => bootstrap.Modal.getOrCreateInstance(document.getElementById('newTopicModal')).show());
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
