@page "/documentation/view/{spaceKey}/{topicKey}/{pageKey}/{version?}"
@model KnOwl.Documentation.WebUI.Pages.Documentation.ViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.PageTitle</h1>
        <p class="od-page-subtitle">@Model.SpaceKey / @Model.TopicKey / @Model.PageKey</p>
    </div>
    <div class="event-list-actions">
        @if (Model.Rendered is not null)
        {
            <a class="btn btn-secondary btn-sm" href="/docs/@Model.SpaceKey/@Model.TopicKey/@Model.PageKey/@Model.Rendered.Version.VersionNumber/source.md">MD</a>
            <a class="btn btn-secondary btn-sm" href="/docs/@Model.SpaceKey/@Model.TopicKey/@Model.PageKey/@Model.Rendered.Version.VersionNumber/package.zip">ZIP</a>
            <button class="btn btn-secondary btn-sm" type="button" data-history-back data-fallback-url="@Url.Page("/Documentation/Page", new { id = Model.Rendered.Version.PageId })">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        }
        else
        {
            <button class="btn btn-secondary btn-sm" type="button" data-history-back data-fallback-url="@Url.Page("/Documentation/Index")">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        }
    </div>
</div>

<section class="od-panel">
    @if (Model.Rendered is null)
    {
        <div class="events-empty-state">
            <i class="bi bi-file-earmark-x"></i>
            <h3>Documentation not found</h3>
            <p>No published version is available for this page.</p>
        </div>
    }
    else
    {
        <article class="documentation-reader">
            @Html.Raw(Model.Rendered.Html)
        </article>
    }
</section>
