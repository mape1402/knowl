@page "/documentation/spaces/{spaceId:guid}/topics/{topicId:guid}/pages/{pageId:guid}/versions/{versionId:guid}/view"
@model KnOwl.Documentation.WebUI.Pages.Documentation.ViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var toc = Model.Rendered?.TableOfContents ?? Array.Empty<KnOwl.Documentation.Application.DocumentationTableOfContentsItem>();
    var showToc = toc.Count >= 2;
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">@Model.PageTitle</h1>
        <p class="od-page-subtitle">@Model.SpaceKey / @Model.TopicKey / @Model.PageKey</p>
    </div>
    <div class="event-list-actions">
        @if (Model.Rendered is not null)
        {
            <button class="btn btn-secondary btn-sm" type="button" data-documentation-focus-toggle aria-pressed="false" title="Use the full page reading view">
                <i class="bi bi-arrows-fullscreen"></i>
                <span>Focus</span>
            </button>
            <a class="btn btn-secondary btn-sm" href="@Url.Page("/Documentation/Source", new { spaceId = Model.SpaceId, topicId = Model.TopicId, pageId = Model.PageId, versionId = Model.VersionId })">MD</a>
            <a class="btn btn-secondary btn-sm" href="@Url.Page("/Documentation/Package", new { spaceId = Model.SpaceId, topicId = Model.TopicId, pageId = Model.PageId, versionId = Model.VersionId })">ZIP</a>
            <button class="btn btn-secondary btn-sm" type="button" data-history-back data-fallback-url="@Url.Page("/Documentation/Page", new { spaceId = Model.SpaceId, topicId = Model.TopicId, pageId = Model.PageId })">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        }
        else
        {
            <button class="btn btn-secondary btn-sm" type="button" data-history-back data-fallback-url="@Url.Page("/Documentation/Index")">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        }
    </div>
</div>

<section class="od-panel documentation-render-panel">
    @if (Model.Rendered is null)
    {
        <div class="events-empty-state">
            <i class="bi bi-file-earmark-x"></i>
            <h3>Documentation not found</h3>
            <p>No published version is available for this page.</p>
        </div>
    }
    else
    {
        <div class="documentation-focus-controls" aria-label="Reading controls">
            <button class="theme-toggle-btn documentation-focus-theme" type="button" data-theme-toggle aria-label="Switch color mode" title="Switch color mode">
                <i class="bi bi-moon-stars"></i>
                <span>Dark</span>
            </button>
            <button class="documentation-focus-exit" type="button" data-documentation-focus-exit title="Exit full page reading view">
                <i class="bi bi-fullscreen-exit"></i>
                <span>Exit</span>
            </button>
        </div>
        <div class="documentation-search" data-documentation-search>
            <label class="documentation-search-label" for="documentation-render-search">Search</label>
            <div class="documentation-search-controls">
                <div class="documentation-search-input-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input id="documentation-render-search" class="documentation-search-input" type="search" autocomplete="off" placeholder="Search this page" data-documentation-search-input />
                </div>
                <span class="documentation-search-count" data-documentation-search-count aria-live="polite"></span>
                <button class="documentation-search-button" type="button" data-documentation-search-prev disabled aria-label="Previous match">
                    <i class="bi bi-chevron-up"></i>
                    <span>Prev</span>
                </button>
                <button class="documentation-search-button" type="button" data-documentation-search-next disabled aria-label="Next match">
                    <i class="bi bi-chevron-down"></i>
                    <span>Next</span>
                </button>
                <button class="documentation-search-button" type="button" data-documentation-search-clear disabled aria-label="Clear search">
                    <i class="bi bi-x-lg"></i>
                    <span>Clear</span>
                </button>
            </div>
        </div>
        <div class="documentation-reader-layout @(showToc ? "has-toc" : "without-toc")">
            <article class="documentation-reader" tabindex="-1">
                @Html.Raw(Model.Rendered.Html)
            </article>
            @if (showToc)
            {
                <aside class="documentation-toc" aria-label="Table of contents">
                    <div class="documentation-toc-title">On this page</div>
                    <nav>
                        @foreach (var item in toc)
                        {
                            <a class="documentation-toc-link documentation-toc-level-@Math.Min(item.Level, 4)" href="#@item.Id" title="@item.Title">@item.Title</a>
                        }
                    </nav>
                </aside>
            }
        </div>
    }
</section>
