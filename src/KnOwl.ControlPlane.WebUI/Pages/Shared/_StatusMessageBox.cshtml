@model string?

@if (!string.IsNullOrWhiteSpace(Model))
{
    <div class="knowl-toast" role="status" data-message-toast data-message-timeout="5200">
        <span class="knowl-toast-icon" aria-hidden="true">
            <i class="bi bi-info-circle"></i>
        </span>
        <div>
            <div class="knowl-toast-title">Message</div>
            <div class="knowl-toast-body">@Model</div>
        </div>
        <button class="knowl-toast-close" type="button" data-message-dismiss aria-label="Close message">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
}
