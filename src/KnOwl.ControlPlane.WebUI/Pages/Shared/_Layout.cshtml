@inject IMenuService MenuService
@inject Microsoft.Extensions.Options.IOptions<KnOwl.ControlPlane.WebUI.KnOwlControlPlaneThemeOptions> ThemeOptions
@{
    var menuItems = MenuService.Items;
    var theme = ThemeOptions.Value;
    var appTitle = string.IsNullOrWhiteSpace(theme.Title) ? "KnOwl" : theme.Title;
    var pageTitle = ViewData["Title"]?.ToString() ?? appTitle;
    var iconCssClass = string.IsNullOrWhiteSpace(theme.IconCssClass) ? "bi bi-hexagon-fill" : theme.IconCssClass;
    var principal = User;
    var isAuthenticated = principal?.Identity?.IsAuthenticated == true;
    var userDisplayName = string.Empty;
    var userEmail = string.Empty;
    var userInitials = string.Empty;

    if (isAuthenticated && principal is not null)
    {
        userDisplayName = principal.FindFirst("name")?.Value
            ?? principal.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
            ?? principal.Identity?.Name
            ?? "Signed in";
        userEmail = principal.FindFirst("preferred_username")?.Value
            ?? principal.FindFirst("upn")?.Value
            ?? principal.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? principal.FindFirst("email")?.Value
            ?? string.Empty;
        if (string.IsNullOrWhiteSpace(userDisplayName))
        {
            userDisplayName = string.IsNullOrWhiteSpace(userEmail) ? "Signed in" : userEmail;
        }

        var initialsSource = string.IsNullOrWhiteSpace(userDisplayName) || userDisplayName.Contains('@', StringComparison.Ordinal)
            ? userEmail
            : userDisplayName;
        var initials = new List<char>();
        foreach (var part in initialsSource.Split(new[] { ' ', '.', '_', '-', '@' }, StringSplitOptions.RemoveEmptyEntries))
        {
            initials.Add(char.ToUpperInvariant(part[0]));
            if (initials.Count == 2)
            {
                break;
            }
        }

        userInitials = initials.Count == 0 ? "U" : new string(initials.ToArray());
    }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@theme.CssMode" data-knowl-theme="@theme.CssMode" style="color-scheme: var(--knowl-color-scheme);">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - @appTitle</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/_content/KnOwl.ControlPlane.WebUI/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        @Html.Raw(theme.ToCssThemeRules())
    </style>
    <link rel="stylesheet" href="~/_content/KnOwl.ControlPlane.WebUI/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">

        <!-- ── Sidebar ──────────────────────────────── -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand">
                <a class="brand-link" asp-area="" asp-page="/Index">
                    <span class="brand-icon">
                        @if (!string.IsNullOrWhiteSpace(theme.IconImageUrl))
                        {
                            <img src="@theme.IconImageUrl" alt="" />
                        }
                        else
                        {
                            <i class="@iconCssClass"></i>
                        }
                    </span>
                    <span class="brand-name">@appTitle</span>
                </a>
            </div>

            <div class="sidebar-nav">
                @{
                    int groupIndex = 0;
                }
                @foreach (var item in menuItems)
                {
                    if (item.HasChildren)
                    {
                        var collapseId = $"nav-group-{groupIndex++}";
                        <div class="nav-group">
                            <button class="nav-group-toggle" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="true">
                                @if (item.Icon is not null)
                                {
                                    <i class="bi bi-@item.Icon nav-icon"></i>
                                }
                                <span class="nav-label">@item.Text</span>
                                <i class="bi bi-chevron-down nav-caret"></i>
                            </button>
                            <div class="collapse show nav-group-items" id="@collapseId">
                                @foreach (var child in item.Children)
                                {
                                    <a class="nav-item-link nav-child" href="@child.Url">
                                        @if (child.Icon is not null)
                                        {
                                            <i class="bi bi-@child.Icon nav-icon"></i>
                                        }
                                        <span>@child.Text</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="nav-item-link" href="@item.Url">
                            @if (item.Icon is not null)
                            {
                                <i class="bi bi-@item.Icon nav-icon"></i>
                            }
                            <span>@item.Text</span>
                        </a>
                    }
                }
            </div>
        </nav>

        <!-- ── Content area ─────────────────────────── -->
        <div class="content-shell">
            <header class="topbar">
                <div class="topbar-left">
                    <button id="sidebar-toggle" class="hamburger-btn" type="button" aria-label="Toggle sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="topbar-title">@pageTitle</span>
                </div>
                <div class="topbar-actions">
                    <button id="theme-toggle" class="theme-toggle-btn" type="button" data-theme-toggle aria-label="Switch color mode" title="Switch color mode">
                        <i class="bi bi-moon-stars"></i>
                        <span>Dark</span>
                    </button>
                    @if (isAuthenticated)
                    {
                        <details class="topbar-user-menu">
                            <summary class="topbar-user-trigger" title="@userDisplayName" aria-label="User menu">
                                <span class="topbar-user-avatar" aria-hidden="true">@userInitials</span>
                                <span class="topbar-user-text">
                                    <span class="topbar-user-name">@userDisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(userEmail) && !string.Equals(userEmail, userDisplayName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="topbar-user-email">@userEmail</span>
                                    }
                                </span>
                                <i class="bi bi-chevron-down topbar-user-caret" aria-hidden="true"></i>
                            </summary>
                            <div class="topbar-user-dropdown">
                                <div class="topbar-user-menu-header">
                                    <span class="topbar-user-menu-name">@userDisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(userEmail) && !string.Equals(userEmail, userDisplayName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="topbar-user-menu-email">@userEmail</span>
                                    }
                                </div>
                                <a class="topbar-user-menu-item" href="@($"{Context.Request.PathBase}/auth/logout?returnUrl=/")">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Sign out</span>
                                </a>
                            </div>
                        </details>
                    }
                </div>
            </header>
            <main class="content-body">
                @RenderBody()
            </main>
            <footer class="content-footer">
                &copy; 2026 @appTitle &middot; <a asp-area="" asp-page="/Privacy">Privacy</a>
            </footer>
        </div>

    </div>

    <script src="~/_content/KnOwl.ControlPlane.WebUI/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
