@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.RuntimeEnvironments.IndexModel
@{
    ViewData["Title"] = "Runtime Environments";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Environments</h1>
        <p class="od-page-subtitle">Runtime deployment targets used to organize nodes and releases.</p>
    </div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#environmentModal" data-mode="new">
        <i class="bi bi-plus-lg"></i> New environment
    </button>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="environments-search">
        <span>Search environments</span>
        <input id="environments-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, code, description, status" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Contracts/RuntimeEnvironments/Index">Clear</a>
        <span class="od-search-count">@Model.Environments.Count of @Model.TotalEnvironments</span>
    }
</form>

@if (!Model.Environments.Any())
{
    <section class="od-panel">
        <p class="od-empty">@(string.IsNullOrWhiteSpace(Model.Search) ? "No environments found." : "No environments match the current search.")</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var env in Model.Environments)
            {
                <article class="od-item-card">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@env.Name</h2>
                            <p class="od-item-meta">@env.Code</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            @if (env.IsEnabled)
                            {
                                <span class="od-status od-status-active">Enabled</span>
                            }
                            else
                            {
                                <span class="od-status od-status-inactive">Disabled</span>
                            }
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Environment actions">
                                    <span aria-hidden="true">...</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button class="dropdown-item" type="button"
                                                data-bs-toggle="modal"
                                                data-bs-target="#environmentModal"
                                                data-mode="edit"
                                                data-id="@env.Id"
                                                data-name="@env.Name"
                                                data-code="@env.Code"
                                                data-enabled="@env.IsEnabled.ToString().ToLowerInvariant()"
                                                data-description="@env.Description">
                                            Edit
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(env.Description) ? "No description." : env.Description)</p>
                    <div class="od-card-footer">
                        <span class="od-card-date">Created @env.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="modal fade" id="environmentModal" tabindex="-1" aria-hidden="true" data-show="@Model.ShowEnvironmentModal.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Runtime Environment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="knowl-message-box knowl-message-danger"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Name"></label>
                        <input class="form-control" asp-for="Input.Name" />
                        <span class="text-danger" asp-validation-for="Input.Name"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Code"></label>
                        <input class="form-control" asp-for="Input.Code" />
                        <span class="text-danger" asp-validation-for="Input.Code"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.IsEnabled" />
                        <label class="form-check-label" asp-for="Input.IsEnabled"></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Input.Description"></label>
                        <textarea class="form-control" asp-for="Input.Description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save environment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modal = document.getElementById('environmentModal');
    if (!modal) return;
    if (modal.dataset.show === 'true') {
        bootstrap.Modal.getOrCreateInstance(modal).show();
    }
    modal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const isEdit = button?.dataset.mode === 'edit';
        modal.querySelector('[name="Input.Id"]').value = isEdit ? button.dataset.id : '';
        modal.querySelector('[name="Input.Name"]').value = isEdit ? button.dataset.name : '';
        modal.querySelector('[name="Input.Code"]').value = isEdit ? button.dataset.code : '';
        modal.querySelector('[name="Input.IsEnabled"]').checked = isEdit ? button.dataset.enabled === 'true' : true;
        modal.querySelector('[name="Input.Description"]').value = isEdit ? (button.dataset.description || '') : '';
    });
})();
</script>
}
