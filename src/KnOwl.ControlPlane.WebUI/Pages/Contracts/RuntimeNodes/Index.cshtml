@page
@using KnOwl.Contracts.Distribution
@using KnOwl.ControlPlane.Distribution.Core
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.RuntimeNodes.IndexModel
@{
    ViewData["Title"] = "Runtime Nodes";

    string StatusClass(RuntimeNode node)
        => node.IsEnabled && node.Status == RuntimeNodeStatus.Active
            ? "od-status od-status-active"
            : "od-status od-status-inactive";

    string DistributionLabel(DistributionMode mode) => mode switch
    {
        DistributionMode.Push => "Control Plane pushes",
        DistributionMode.Pull => "Runtime pulls",
        DistributionMode.Hybrid => "Both directions",
        _ => mode.ToString()
    };
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Runtime Nodes</h1>
        <p class="od-page-subtitle">Execution engines available for releases.</p>
    </div>
    <button class="btn btn-primary js-open-runtime-wizard" type="button" data-mode="new">Create runtime node</button>
</div>

@await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

@if (!Model.RuntimeNodes.Any())
{
    <section class="od-panel">
        <p class="od-empty">No runtime nodes found.</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid od-runtime-node-grid">
            @foreach (var node in Model.RuntimeNodes)
            {
                var environmentName = node.Environment?.Name ?? node.EnvironmentName;
                var credentialReadiness = CredentialReadiness(node);
                var endpointReadiness = EndpointReadiness(node);
                var canCheckConnection = node.IsEnabled &&
                    node.Status == RuntimeNodeStatus.Active &&
                    node.DistributionMode is DistributionMode.Push or DistributionMode.Hybrid;
                <article class="od-item-card od-runtime-node-card"
                         data-runtime-node-card
                         data-id="@node.Id"
                         data-name="@node.Name"
                         data-code="@node.Code"
                         data-environment-id="@node.EnvironmentId"
                         data-environment-name="@environmentName"
                         data-distribution-mode="@node.DistributionMode"
                         data-distribution-mode-label="@DistributionLabel(node.DistributionMode)"
                         data-endpoint-base-uri="@node.EndpointBaseUri"
                         data-status="@node.Status"
                         data-enabled="@node.IsEnabled.ToString().ToLowerInvariant()"
                         data-description="@node.Description"
                         data-inbound-credential-status="@node.InboundCredentialStatus"
                         data-outbound-credential-status="@node.OutboundCredentialStatus"
                         data-credential-readiness="@credentialReadiness"
                         data-endpoint-readiness="@endpointReadiness"
                         data-inbound-client-id="@node.InboundClientId"
                         data-inbound-key-id="@node.InboundKeyId"
                         data-inbound-allowed-scopes="@node.InboundAllowedScopes"
                         data-outbound-client-id="@node.OutboundClientId"
                         data-outbound-key-id="@node.OutboundKeyId"
                         data-outbound-requested-scopes="@node.OutboundRequestedScopes"
                         data-registered-at="@node.RegisteredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")"
                         data-updated-at="@(node.LastUpdatedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? node.RegisteredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@node.Name</h2>
                            <p class="od-item-meta">@node.Code | @(string.IsNullOrWhiteSpace(environmentName) ? "-" : environmentName)</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="@StatusClass(node)">@(node.IsEnabled ? "Enabled" : "Disabled")</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form method="post"
                                              asp-page-handler="SetEnabled"
                                              class="od-inline-form"
                                              data-status-transition-form
                                              data-confirm-title="@(node.IsEnabled ? "Disable runtime node" : "Enable runtime node")"
                                              data-confirm-message="@(node.IsEnabled ? "Disable this runtime node for distribution?" : "Enable this runtime node for distribution?")"
                                              data-confirm-label="@(node.IsEnabled ? "Disable" : "Enable")">
                                            <input type="hidden" name="runtimeNodeId" value="@node.Id" />
                                            <input type="hidden" name="isEnabled" value="@(!node.IsEnabled)" />
                                            <button class="dropdown-item" type="submit">@(node.IsEnabled ? "Disable node" : "Enable node")</button>
                                        </form>
                                    </li>
                                    @if (canCheckConnection)
                                    {
                                        <li>
                                            <form method="post" asp-page-handler="ValidateConnection" class="od-inline-form">
                                                <input type="hidden" name="runtimeNodeId" value="@node.Id" />
                                                <button class="dropdown-item" type="submit">Check connection</button>
                                            </form>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post"
                                              asp-page-handler="Delete"
                                              class="od-inline-form"
                                              data-status-transition-form
                                              data-confirm-title="Delete runtime node"
                                              data-confirm-message="Delete this runtime node from active configuration? Existing release references will be preserved."
                                              data-confirm-label="Delete">
                                            <input type="hidden" name="runtimeNodeId" value="@node.Id" />
                                            <button class="dropdown-item text-danger" type="submit">Delete node</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="od-runtime-card-summary">
                        <div>
                            <span>Environment</span>
                            <strong>@(string.IsNullOrWhiteSpace(environmentName) ? "-" : environmentName)</strong>
                        </div>
                        <div>
                            <span>Policy</span>
                            <strong>@DistributionLabel(node.DistributionMode)</strong>
                        </div>
                        <div>
                            <span>Credentials</span>
                            <strong class="@ReadinessClass(credentialReadiness)">@credentialReadiness</strong>
                        </div>
                        <div>
                            <span>Endpoint</span>
                            <strong>@endpointReadiness</strong>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(node.Description) ? "No description." : node.Description)</p>
                    <p class="od-item-meta">Updated @(node.LastUpdatedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? node.RegisteredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</p>
                    <div class="od-card-actions">
                        <button class="btn btn-outline-secondary btn-sm js-open-runtime-wizard" type="button">Configure</button>
                        <button class="btn btn-outline-primary btn-sm js-open-runtime-details" type="button">Details</button>
                    </div>
                </article>
            }
        </div>
    </section>
}

<div class="modal fade" id="runtimeDetailsModal" tabindex="-1" aria-labelledby="runtimeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="runtimeDetailsModalLabel">Runtime node details</h5>
                    <p class="od-item-meta mb-0" id="runtimeDetailsSubtitle">Runtime node</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body od-runtime-node-view-body">
                <div class="od-section-head">
                    <div>
                        <h2 class="od-section-title" id="runtimeDetailsName">Runtime node</h2>
                        <p class="od-item-meta" id="runtimeDetailsCode">-</p>
                    </div>
                    <span class="od-status" id="runtimeDetailsStatus">-</span>
                </div>
                <div class="od-info-grid od-info-grid-compact">
                    <div class="od-info-tile"><span>Environment</span><strong id="runtimeDetailsEnvironment">-</strong></div>
                    <div class="od-info-tile"><span>Policy</span><strong id="runtimeDetailsPolicy">-</strong></div>
                    <div class="od-info-tile"><span>Credentials</span><strong id="runtimeDetailsCredentials">-</strong></div>
                    <div class="od-info-tile"><span>Endpoint</span><strong id="runtimeDetailsEndpoint">-</strong></div>
                    <div class="od-info-tile"><span>Created</span><strong id="runtimeDetailsCreated">-</strong></div>
                    <div class="od-info-tile"><span>Updated</span><strong id="runtimeDetailsUpdated">-</strong></div>
                </div>
                <div class="od-info-block mt-3">
                    <span>Description</span>
                    <p id="runtimeDetailsDescription">-</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="runtimeDetailsConfigureButton">Configure</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="runtimeWizardModal" tabindex="-1" aria-labelledby="runtimeWizardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="runtimeWizardModalLabel">Runtime node setup</h5>
                    <p class="od-item-meta mb-0" id="runtimeWizardSubtitle">Create the node, choose policy, exchange credentials, then verify.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body od-runtime-setup-body">
                <aside class="od-setup-rail" aria-label="Runtime setup steps">
                    <button type="button" class="od-setup-step active" data-runtime-step-target="basic"><span>1</span> Basic data</button>
                    <button type="button" class="od-setup-step" data-runtime-step-target="policy"><span>2</span> Policy</button>
                    <button type="button" class="od-setup-step" data-runtime-step-target="runtimeCredentials"><span>3</span> Runtime credentials</button>
                    <button type="button" class="od-setup-step" data-runtime-step-target="controlPlaneCredentials"><span>4</span> Control Plane credentials</button>
                    <button type="button" class="od-setup-step" data-runtime-step-target="verify"><span>5</span> Verify</button>
                </aside>
                <div class="od-setup-panels">
                    <section class="od-setup-panel active" data-runtime-step="basic">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Basic data</h2>
                                <p class="od-item-meta">Runtime identity and environment dependency.</p>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="WizardUpsert" id="runtimeBasicForm" data-runtime-wizard-form>
                            <input type="hidden" name="Input.Id" data-runtime-field="id" />
                            <input type="hidden" name="Input.DistributionMode" data-runtime-field="distributionMode" value="Pull" />
                            <input type="hidden" name="Input.EndpointBaseUri" data-runtime-field="endpointBaseUri" />
                            <input type="hidden" name="Input.Status" data-runtime-field="status" value="Active" />
                            <input type="hidden" name="Input.IsEnabled" data-runtime-field="isEnabled" value="false" />
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="runtimeNameInput">Name</label>
                                    <input class="form-control" id="runtimeNameInput" name="Input.Name" data-runtime-field="name" autocomplete="off" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="runtimeCodeInput">Code</label>
                                    <input class="form-control" id="runtimeCodeInput" name="Input.Code" data-runtime-field="code" autocomplete="off" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="runtimeEnvironmentInput">Environment</label>
                                    <select class="form-select" id="runtimeEnvironmentInput" name="Input.EnvironmentId" data-runtime-field="environmentId">
                                        <option value="">Select environment</option>
                                        @foreach (var environment in Model.Environments)
                                        {
                                            <option value="@environment.Id">@environment.Name (@environment.Code)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="runtimeDescriptionInput">Description</label>
                                    <input class="form-control" id="runtimeDescriptionInput" name="Input.Description" data-runtime-field="description" autocomplete="off" />
                                </div>
                            </div>
                        </form>
                    </section>

                    <section class="od-setup-panel" data-runtime-step="policy">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Distribution policy</h2>
                                <p class="od-item-meta">Choose who moves release artifacts.</p>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="WizardUpsert" id="runtimePolicyForm" data-runtime-wizard-form>
                            <input type="hidden" name="Input.Id" data-runtime-field="id" />
                            <input type="hidden" name="Input.Name" data-runtime-field="name" />
                            <input type="hidden" name="Input.Code" data-runtime-field="code" />
                            <input type="hidden" name="Input.EnvironmentId" data-runtime-field="environmentId" />
                            <input type="hidden" name="Input.Description" data-runtime-field="description" />
                            <input type="hidden" name="Input.EndpointBaseUri" data-runtime-field="endpointBaseUri" />
                            <input type="hidden" name="Input.Status" data-runtime-field="status" value="Active" />
                            <input type="hidden" name="Input.IsEnabled" data-runtime-field="isEnabled" value="false" />
                            <div class="od-policy-options">
                                <label class="od-policy-option">
                                    <input type="radio" name="Input.DistributionMode" value="Push" />
                                    <span><strong>Control Plane pushes</strong><small>Control Plane sends artifacts to the Runtime endpoint.</small></span>
                                </label>
                                <label class="od-policy-option">
                                    <input type="radio" name="Input.DistributionMode" value="Pull" />
                                    <span><strong>Runtime pulls</strong><small>Runtime imports available releases from Control Plane.</small></span>
                                </label>
                                <label class="od-policy-option">
                                    <input type="radio" name="Input.DistributionMode" value="Hybrid" />
                                    <span><strong>Both directions</strong><small>Control Plane can push and Runtime can pull.</small></span>
                                </label>
                            </div>
                        </form>
                    </section>

                    <section class="od-setup-panel" data-runtime-step="runtimeCredentials">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Runtime credentials</h2>
                                <p class="od-item-meta">Required when Control Plane pushes artifacts to Runtime.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="od-status od-status-queued" id="runtimeCredentialStatus">Missing</span>
                                <button type="button" class="btn btn-primary btn-sm" id="runtimeOpenImportCredentialsButton">Import credentials</button>
                            </div>
                        </div>
                        <div class="od-info-grid od-info-grid-compact mt-3">
                            <div class="od-info-tile"><span>Runtime endpoint</span><strong id="runtimeEndpointSummary">-</strong></div>
                            <div class="od-info-tile"><span>Client ID</span><strong id="runtimeOutboundClientId">-</strong></div>
                            <div class="od-info-tile"><span>Key ID</span><strong id="runtimeOutboundKeyId">-</strong></div>
                            <div class="od-info-tile"><span>Scopes</span><strong id="runtimeOutboundScopes">-</strong></div>
                        </div>
                    </section>

                    <section class="od-setup-panel" data-runtime-step="controlPlaneCredentials">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Control Plane credentials</h2>
                                <p class="od-item-meta">Required when Runtime pulls artifacts from Control Plane.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="od-status od-status-queued" id="runtimeInboundCredentialStatus">Missing</span>
                                <button type="button" class="btn btn-primary btn-sm" id="runtimeGenerateCredentialsButton">Generate credentials</button>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="WizardGenerateCredentials" id="runtimeGenerateCredentialForm" class="d-none" data-runtime-wizard-form>
                            <input type="hidden" name="CredentialInput.RuntimeNodeId" data-runtime-field="id" />
                        </form>
                        <div class="knowl-message-box knowl-message-info mt-3">
                            <i class="bi bi-info-circle"></i>
                            <span>The Runtime imports this package when it will pull artifacts from this Control Plane.</span>
                        </div>
                    </section>

                    <section class="od-setup-panel" data-runtime-step="verify">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Verify</h2>
                                <p class="od-item-meta">Check Control Plane connectivity to the Runtime endpoint.</p>
                            </div>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Environment</span><strong id="runtimeVerifyEnvironment">-</strong></div>
                            <div class="od-info-tile"><span>Mode</span><strong id="runtimeVerifyMode">-</strong></div>
                            <div class="od-info-tile"><span>Endpoint</span><strong id="runtimeVerifyEndpoint">-</strong></div>
                            <div class="od-info-tile"><span>Readiness</span><strong id="runtimeVerifyReadiness">-</strong></div>
                        </div>
                        <form method="post" asp-page-handler="WizardValidateConnection" id="runtimeValidateForm" class="d-none" data-runtime-wizard-form>
                            <input type="hidden" name="runtimeNodeId" data-runtime-field="id" />
                        </form>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button type="button" class="btn btn-secondary btn-sm" id="runtimeValidateButton">Check connection</button>
                        </div>
                    </section>
                </div>
            </div>
            <div class="modal-footer od-runtime-wizard-footer">
                <button type="button" class="btn btn-secondary" id="runtimeWizardBack">Back</button>
                <button type="button" class="btn btn-primary" id="runtimeWizardNext">Next</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="runtimeImportCredentialsModal" tabindex="-1" aria-labelledby="runtimeImportCredentialsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="WizardImportCredentials" id="runtimeImportCredentialForm" data-runtime-wizard-form>
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="runtimeImportCredentialsModalLabel">Import Runtime credentials</h5>
                        <p class="od-item-meta mb-0">Paste the JSON generated by the Runtime host.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="CredentialImportInput.RuntimeNodeId" data-runtime-field="id" />
                    <label class="form-label" for="runtimeCredentialsJson">Runtime credentials JSON</label>
                    <textarea class="form-control font-monospace" id="runtimeCredentialsJson" name="CredentialImportInput.Package" rows="12" placeholder="Paste JSON or Base64 package"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import and continue</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="runtimeGeneratedCredentialsModal" tabindex="-1" aria-labelledby="runtimeGeneratedCredentialsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="runtimeGeneratedCredentialsModalLabel">Generated Control Plane credentials</h5>
                    <p class="od-item-meta mb-0" id="runtimeGeneratedCredentialNodeName">Runtime node</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="knowl-message-box knowl-message-warning mb-3">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Copy these credentials now. The secret is only shown once.</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label">JSON</label>
                    <button type="button" class="btn btn-secondary btn-sm" data-runtime-copy="#runtimeGeneratedJson">Copy JSON</button>
                </div>
                <textarea id="runtimeGeneratedJson" class="form-control font-monospace" rows="10" readonly></textarea>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <label class="form-label">Base64</label>
                    <button type="button" class="btn btn-secondary btn-sm" data-runtime-copy="#runtimeGeneratedBase64">Copy Base64</button>
                </div>
                <textarea id="runtimeGeneratedBase64" class="form-control font-monospace" rows="4" readonly></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string CredentialReadiness(RuntimeNode node)
    {
        var needsRuntimeCredentials = node.DistributionMode is DistributionMode.Push or DistributionMode.Hybrid;
        var needsControlPlaneCredentials = node.DistributionMode is DistributionMode.Pull or DistributionMode.Hybrid;
        var hasRuntimeCredentials = node.OutboundCredentialStatus == KnOwl.Contracts.Security.ConnectionCredentialStatus.Active;
        var hasControlPlaneCredentials = node.InboundCredentialStatus == KnOwl.Contracts.Security.ConnectionCredentialStatus.Active;

        if (needsRuntimeCredentials && needsControlPlaneCredentials)
        {
            return hasRuntimeCredentials && hasControlPlaneCredentials
                ? "Ready"
                : !hasRuntimeCredentials && !hasControlPlaneCredentials
                    ? "Missing both"
                    : hasRuntimeCredentials ? "Missing Control Plane" : "Missing Runtime";
        }

        if (needsRuntimeCredentials)
        {
            return hasRuntimeCredentials ? "Ready" : "Missing Runtime";
        }

        if (needsControlPlaneCredentials)
        {
            return hasControlPlaneCredentials ? "Ready" : "Missing Control Plane";
        }

        return "Not required";
    }

    private static string EndpointReadiness(RuntimeNode node)
    {
        if (node.DistributionMode == DistributionMode.Pull)
        {
            return "Not required";
        }

        return string.IsNullOrWhiteSpace(node.EndpointBaseUri) ? "Missing" : node.EndpointBaseUri;
    }

    private static string ReadinessClass(string value)
        => value switch
        {
            "Ready" => "od-runtime-card-ready",
            "Not required" => "od-runtime-card-muted",
            var next when next.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
                          next.StartsWith("https://", StringComparison.OrdinalIgnoreCase) => "od-runtime-card-ready",
            _ => "od-runtime-card-warning"
        };
}

@section Scripts {
<script>
(() => {
    const modalElement = document.getElementById('runtimeWizardModal');
    if (!modalElement || !window.bootstrap?.Modal) return;

    const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
    const importModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('runtimeImportCredentialsModal'));
    const generatedModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('runtimeGeneratedCredentialsModal'));
    const detailsModalElement = document.getElementById('runtimeDetailsModal');
    const detailsModal = detailsModalElement ? bootstrap.Modal.getOrCreateInstance(detailsModalElement) : null;
    const baseSteps = {
        Push: ['basic', 'policy', 'runtimeCredentials'],
        Pull: ['basic', 'policy', 'controlPlaneCredentials'],
        Hybrid: ['basic', 'policy', 'runtimeCredentials', 'controlPlaneCredentials']
    };
    let steps = [...baseSteps.Pull];
    let activeStep = 'basic';
    let current = null;
    let currentDetailsNode = null;
    let createdDuringSession = false;

    const stepButtons = Array.from(modalElement.querySelectorAll('[data-runtime-step-target]'));
    const stepPanels = Array.from(modalElement.querySelectorAll('[data-runtime-step]'));
    const backButton = document.getElementById('runtimeWizardBack');
    const nextButton = document.getElementById('runtimeWizardNext');

    const showToast = (message, type = 'info') => {
        const toast = document.createElement('div');
        toast.className = `knowl-toast knowl-toast-${type}`;
        toast.setAttribute('role', 'status');
        toast.setAttribute('data-message-toast', '');
        toast.innerHTML = `
            <span class="knowl-toast-icon" aria-hidden="true"><i class="bi bi-info-circle"></i></span>
            <div><div class="knowl-toast-title">${type === 'error' ? 'Review' : 'Message'}</div><div class="knowl-toast-body"></div></div>
            <button class="knowl-toast-close" type="button" aria-label="Close message"><i class="bi bi-x-lg"></i></button>`;
        toast.querySelector('.knowl-toast-body').textContent = message;
        document.body.appendChild(toast);
        toast.querySelector('button')?.addEventListener('click', () => toast.remove());
        window.setTimeout(() => toast.remove(), type === 'error' ? 7200 : 4200);
    };

    const value = key => current?.[key] ?? '';
    const isPushMode = mode => mode === 'Push' || mode === 'Hybrid';
    const isPullMode = mode => mode === 'Pull' || mode === 'Hybrid';
    const isActiveCredential = status => status === 'Active';
    const canCheckConnection = () => value('status') === 'Active' && value('isEnabled') === true && isPushMode(value('distributionMode') || 'Pull');
    const isConfigured = () => {
        const mode = value('distributionMode') || 'Pull';
        return (!isPushMode(mode) || (isActiveCredential(value('outboundCredentialStatus')) && !!String(value('endpointBaseUri') || '').trim())) &&
            (!isPullMode(mode) || isActiveCredential(value('inboundCredentialStatus')));
    };
    const environmentText = () => {
        const select = document.getElementById('runtimeEnvironmentInput');
        const selected = select?.selectedOptions?.[0]?.textContent || '';
        return selected.trim() || value('environmentName') || '-';
    };
    const pick = (source, ...names) => {
        for (const name of names) {
            const next = source?.[name];
            if (next !== undefined && next !== null) {
                return next;
            }
        }

        return '';
    };
    const selectedEnvironmentName = () => {
        const select = document.getElementById('runtimeEnvironmentInput');
        const selected = select?.selectedOptions?.[0]?.textContent?.trim() || '';
        return selected.replace(/\s*\([^)]+\)\s*$/, '');
    };
    const readBasicState = () => ({
        id: value('id'),
        name: document.getElementById('runtimeNameInput')?.value || '',
        code: document.getElementById('runtimeCodeInput')?.value || '',
        environmentId: document.getElementById('runtimeEnvironmentInput')?.value || '',
        environmentName: selectedEnvironmentName(),
        distributionMode: value('distributionMode') || 'Pull',
        distributionModeLabel: value('distributionModeLabel') || 'Runtime pulls',
        endpointBaseUri: value('endpointBaseUri'),
        status: value('status') || 'Active',
        isEnabled: value('isEnabled') === true,
        description: document.getElementById('runtimeDescriptionInput')?.value || '',
        inboundCredentialStatus: value('inboundCredentialStatus') || 'Missing',
        outboundCredentialStatus: value('outboundCredentialStatus') || 'Missing'
    });

    const readNodeFromCard = element => {
        const card = element?.closest('[data-runtime-node-card]');
        if (!card) return null;
        return {
            id: card.dataset.id || '',
            name: card.dataset.name || '',
            code: card.dataset.code || '',
            environmentId: card.dataset.environmentId || '',
            environmentName: card.dataset.environmentName || '',
            distributionMode: card.dataset.distributionMode || 'Pull',
            distributionModeLabel: card.dataset.distributionModeLabel || '',
            endpointBaseUri: card.dataset.endpointBaseUri || '',
            status: card.dataset.status || 'Active',
            isEnabled: card.dataset.enabled === 'true',
            description: card.dataset.description || '',
            inboundCredentialStatus: card.dataset.inboundCredentialStatus || 'Missing',
            outboundCredentialStatus: card.dataset.outboundCredentialStatus || 'Missing',
            credentialReadiness: card.dataset.credentialReadiness || '',
            endpointReadiness: card.dataset.endpointReadiness || '',
            inboundClientId: card.dataset.inboundClientId || '',
            inboundKeyId: card.dataset.inboundKeyId || '',
            inboundAllowedScopes: card.dataset.inboundAllowedScopes || '',
            outboundClientId: card.dataset.outboundClientId || '',
            outboundKeyId: card.dataset.outboundKeyId || '',
            outboundRequestedScopes: card.dataset.outboundRequestedScopes || '',
            registeredAt: card.dataset.registeredAt || '-',
            updatedAt: card.dataset.updatedAt || '-'
        };
    };

    const emptyNode = () => ({
        id: '',
        name: '',
        code: '',
        environmentId: '',
        environmentName: '',
        distributionMode: 'Pull',
        distributionModeLabel: 'Runtime pulls',
        endpointBaseUri: '',
        status: 'Active',
        isEnabled: false,
        description: '',
        inboundCredentialStatus: 'Missing',
        outboundCredentialStatus: 'Missing',
        credentialReadiness: 'Missing Control Plane',
        endpointReadiness: 'Not required',
        registeredAt: '-',
        updatedAt: '-'
    });

    const setField = (name, nextValue) => {
        document.querySelectorAll(`[data-runtime-field="${name}"]`).forEach(input => {
            if (input.type === 'radio') {
                input.checked = input.value === String(nextValue || '');
            } else {
                input.value = nextValue ?? '';
            }
        });
    };

    const syncForms = () => {
        setField('id', value('id'));
        setField('name', value('name'));
        setField('code', value('code'));
        setField('environmentId', value('environmentId'));
        setField('distributionMode', value('distributionMode') || 'Pull');
        setField('endpointBaseUri', value('endpointBaseUri'));
        setField('status', value('status') || 'Active');
        setField('isEnabled', value('isEnabled') === true ? 'true' : 'false');
        setField('description', value('description'));

        modalElement.querySelectorAll('input[name="Input.DistributionMode"]').forEach(input => {
            input.checked = input.value === (value('distributionMode') || 'Pull');
        });

        document.getElementById('runtimeCredentialStatus').textContent = value('outboundCredentialStatus') || 'Missing';
        document.getElementById('runtimeInboundCredentialStatus').textContent = value('inboundCredentialStatus') || 'Missing';
        document.getElementById('runtimeEndpointSummary').textContent = value('endpointBaseUri') || '-';
        document.getElementById('runtimeOutboundClientId').textContent = value('outboundClientId') || '-';
        document.getElementById('runtimeOutboundKeyId').textContent = value('outboundKeyId') || '-';
        document.getElementById('runtimeOutboundScopes').textContent = value('outboundRequestedScopes') || '-';
        document.getElementById('runtimeVerifyEnvironment').textContent = environmentText();
        document.getElementById('runtimeVerifyMode').textContent = value('distributionModeLabel') || value('distributionMode') || '-';
        document.getElementById('runtimeVerifyEndpoint').textContent = value('endpointBaseUri') || '-';

        const mode = value('distributionMode') || 'Pull';
        steps = [...(baseSteps[mode] || baseSteps.Pull)];
        if (canCheckConnection()) {
            steps.push('verify');
        }

        stepButtons.forEach(button => {
            const target = button.dataset.runtimeStepTarget;
            const enabled = steps.includes(target) && (target === 'basic' || !!value('id'));
            button.disabled = !enabled;
            button.classList.toggle('is-disabled', !enabled);
        });

        const ready = isConfigured();
        document.getElementById('runtimeVerifyReadiness').textContent = ready ? 'Ready' : 'Pending credentials';
    };

    const setStep = step => {
        if (!steps.includes(step)) {
            step = steps[0] || 'basic';
        }

        activeStep = step;
        stepButtons.forEach(button => button.classList.toggle('active', button.dataset.runtimeStepTarget === step));
        stepPanels.forEach(panel => panel.classList.toggle('active', panel.dataset.runtimeStep === step));
        syncForms();
        const index = steps.indexOf(activeStep);
        backButton.disabled = index === 0;
        nextButton.classList.remove('d-none');
        nextButton.textContent = index === steps.length - 1 ? 'Done' : 'Next';
    };

    const applyNode = node => {
        if (!node) {
            syncForms();
            return;
        }

        current = {
            ...current,
            id: pick(node, 'id', 'Id') || value('id'),
            name: pick(node, 'name', 'Name'),
            code: pick(node, 'code', 'Code'),
            environmentId: pick(node, 'environmentId', 'EnvironmentId'),
            environmentName: pick(node, 'environmentName', 'EnvironmentName'),
            distributionMode: pick(node, 'distributionMode', 'DistributionMode') || 'Pull',
            distributionModeLabel: pick(node, 'distributionModeLabel', 'DistributionModeLabel') || pick(node, 'distributionMode', 'DistributionMode'),
            endpointBaseUri: pick(node, 'endpointBaseUri', 'EndpointBaseUri'),
            status: pick(node, 'status', 'Status') || 'Active',
            isEnabled: pick(node, 'isEnabled', 'IsEnabled') === true || pick(node, 'isEnabled', 'IsEnabled') === 'true',
            description: pick(node, 'description', 'Description'),
            inboundCredentialStatus: pick(node, 'inboundCredentialStatus', 'InboundCredentialStatus') || 'Missing',
            outboundCredentialStatus: pick(node, 'outboundCredentialStatus', 'OutboundCredentialStatus') || 'Missing',
            inboundClientId: pick(node, 'inboundClientId', 'InboundClientId'),
            inboundKeyId: pick(node, 'inboundKeyId', 'InboundKeyId'),
            inboundAllowedScopes: pick(node, 'inboundAllowedScopes', 'InboundAllowedScopes'),
            outboundClientId: pick(node, 'outboundClientId', 'OutboundClientId'),
            outboundKeyId: pick(node, 'outboundKeyId', 'OutboundKeyId'),
            outboundRequestedScopes: pick(node, 'outboundRequestedScopes', 'OutboundRequestedScopes')
        };
        syncForms();
    };

    const readRuntimeNodeId = payload =>
        payload?.runtimeNodeId ||
        payload?.RuntimeNodeId ||
        payload?.node?.id ||
        payload?.node?.Id ||
        payload?.Node?.id ||
        payload?.Node?.Id ||
        '';

    const ensureRuntimeNodeId = payload => {
        const runtimeNodeId = readRuntimeNodeId(payload);
        if (runtimeNodeId) {
            current = { ...current, id: runtimeNodeId };
            syncForms();
        }
    };

    const applyPayloadNode = payload => {
        ensureRuntimeNodeId(payload);
        applyNode(payload.node || payload.Node || current);
        ensureRuntimeNodeId(payload);
    };

    const postForm = async form => {
        const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const text = await response.text();
        let payload = {};
        if (text) {
            try { payload = JSON.parse(text); } catch { payload = { message: text }; }
        }
        if (!response.ok) {
            throw new Error(payload.message || 'The operation failed.');
        }
        return payload;
    };

    const saveBasic = async () => {
        const form = document.getElementById('runtimeBasicForm');
        current = {
            ...current,
            ...readBasicState()
        };
        syncForms();
        const payload = await postForm(form);
        if (!current?.id) createdDuringSession = true;
        applyPayloadNode(payload);
        showToast(payload.message || 'Runtime node saved.');
    };

    const savePolicy = async () => {
        current = {
            ...current,
            distributionMode: modalElement.querySelector('input[name="Input.DistributionMode"]:checked')?.value || 'Pull'
        };
        syncForms();
        const payload = await postForm(document.getElementById('runtimePolicyForm'));
        applyPayloadNode(payload);
        showToast(payload.message || 'Policy saved.');
    };

    const openWizardFromNode = node => {
        current = node || emptyNode();
        document.getElementById('runtimeWizardModalLabel').textContent = current.id ? current.name : 'Create runtime node';
        document.getElementById('runtimeWizardSubtitle').textContent = current.id ? `${current.code || '-'} - ${current.environmentName || 'No environment'}` : 'Create the node, choose policy, exchange credentials, then verify.';
        document.getElementById('runtimeCredentialsJson').value = '';
        setStep('basic');
        detailsModal?.hide();
        modal.show();
    };

    const openWizard = trigger => openWizardFromNode(readNodeFromCard(trigger));

    const setDetailsText = (id, text) => {
        const element = document.getElementById(id);
        if (element) element.textContent = text || '-';
    };

    const openDetails = trigger => {
        const node = readNodeFromCard(trigger);
        if (!node || !detailsModal) return;
        currentDetailsNode = node;

        const statusElement = document.getElementById('runtimeDetailsStatus');
        if (statusElement) {
            statusElement.className = node.isEnabled && node.status === 'Active' ? 'od-status od-status-active' : 'od-status od-status-inactive';
            statusElement.textContent = node.isEnabled ? 'Enabled' : 'Disabled';
        }

        setDetailsText('runtimeDetailsModalLabel', node.name || 'Runtime node details');
        setDetailsText('runtimeDetailsSubtitle', `${node.code || '-'} | ${node.environmentName || '-'}`);
        setDetailsText('runtimeDetailsName', node.name || '-');
        setDetailsText('runtimeDetailsCode', `${node.code || '-'} | ${node.environmentName || '-'}`);
        setDetailsText('runtimeDetailsEnvironment', node.environmentName || '-');
        setDetailsText('runtimeDetailsPolicy', node.distributionModeLabel || node.distributionMode || '-');
        setDetailsText('runtimeDetailsCredentials', node.credentialReadiness || '-');
        setDetailsText('runtimeDetailsEndpoint', node.endpointReadiness || '-');
        setDetailsText('runtimeDetailsCreated', node.registeredAt || '-');
        setDetailsText('runtimeDetailsUpdated', node.updatedAt || '-');
        setDetailsText('runtimeDetailsDescription', node.description || 'No description.');
        detailsModal.show();
    };

    document.querySelectorAll('.js-open-runtime-wizard').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            openWizard(button);
        });
    });

    document.querySelectorAll('.js-open-runtime-details').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            openDetails(button);
        });
    });

    document.getElementById('runtimeDetailsConfigureButton')?.addEventListener('click', event => {
        event.stopPropagation();
        openWizardFromNode(currentDetailsNode);
    });

    stepButtons.forEach(button => {
        button.addEventListener('click', () => setStep(button.dataset.runtimeStepTarget));
    });

    backButton.addEventListener('click', () => {
        const index = steps.indexOf(activeStep);
        setStep(steps[Math.max(0, index - 1)]);
    });

    const moveNextOrComplete = async () => {
        const index = steps.indexOf(activeStep);
        const next = steps[index + 1];
        if (next) {
            setStep(next);
            return;
        }

        modal.hide();
        if (createdDuringSession) {
            window.location.reload();
        }
    };

    nextButton.addEventListener('click', async () => {
        try {
            if (activeStep === 'basic') {
                await saveBasic();
                setStep('policy');
                return;
            }
            if (activeStep === 'policy') {
                await savePolicy();
                await moveNextOrComplete();
                return;
            }
            if (activeStep === 'runtimeCredentials') {
                const mode = value('distributionMode') || 'Pull';
                if (isPushMode(mode) && !isActiveCredential(value('outboundCredentialStatus'))) {
                    throw new Error('Import Runtime credentials before continuing.');
                }
                await moveNextOrComplete();
                return;
            }
            if (activeStep === 'controlPlaneCredentials') {
                const mode = value('distributionMode') || 'Pull';
                if (isPullMode(mode) && !isActiveCredential(value('inboundCredentialStatus'))) {
                    throw new Error('Generate Control Plane credentials before continuing.');
                }
                await moveNextOrComplete();
                return;
            }
            if (activeStep === 'verify') {
                await moveNextOrComplete();
            }
        } catch (error) {
            showToast(error.message || 'Review the runtime node setup.', 'error');
        }
    });

    document.getElementById('runtimeOpenImportCredentialsButton').addEventListener('click', () => {
        if (!value('id')) {
            showToast('Save basic data before importing Runtime credentials.', 'error');
            return;
        }

        document.getElementById('runtimeCredentialsJson').value = '';
        importModal.show();
    });

    document.getElementById('runtimeImportCredentialForm').addEventListener('submit', async event => {
        event.preventDefault();
        event.stopPropagation();
        try {
            const payload = await postForm(event.currentTarget);
            applyPayloadNode(payload);
            importModal.hide();
            showToast(payload.message || 'Runtime credentials imported.');
        } catch (error) {
            showToast(error.message || 'Credential import failed.', 'error');
        }
    });

    document.getElementById('runtimeGenerateCredentialsButton').addEventListener('click', async () => {
        try {
            const payload = await postForm(document.getElementById('runtimeGenerateCredentialForm'));
            applyPayloadNode(payload);
            document.getElementById('runtimeGeneratedJson').value = payload.credentialsJson || '';
            document.getElementById('runtimeGeneratedBase64').value = payload.credentialsBase64 || '';
            document.getElementById('runtimeGeneratedCredentialNodeName').textContent = value('name') || 'Runtime node';
            generatedModal.show();
            showToast(payload.message || 'Control Plane credentials generated.');
        } catch (error) {
            showToast(error.message || 'Credential generation failed.', 'error');
        }
    });

    document.getElementById('runtimeValidateButton').addEventListener('click', async () => {
        try {
            const payload = await postForm(document.getElementById('runtimeValidateForm'));
            applyPayloadNode(payload);
            showToast(payload.message || 'Connection checked.', payload.succeeded ? 'success' : 'error');
        } catch (error) {
            showToast(error.message || 'Connection check failed.', 'error');
        }
    });

    document.querySelectorAll('[data-runtime-copy]').forEach(button => {
        button.addEventListener('click', async () => {
            const target = document.querySelector(button.dataset.runtimeCopy || '');
            const text = target?.value || '';
            if (!text) return;
            await navigator.clipboard.writeText(text).catch(() => {});
            showToast('Copied.');
        });
    });
    modalElement.addEventListener('hidden.bs.modal', () => {
        if (createdDuringSession) {
            window.location.reload();
        }
    });
})();
</script>
}
