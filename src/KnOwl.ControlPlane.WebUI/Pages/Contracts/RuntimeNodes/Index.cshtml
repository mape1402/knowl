@page
@using KnOwl.Contracts.Security
@using KnOwl.ControlPlane.Distribution.Core
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.RuntimeNodes.IndexModel
@{
    ViewData["Title"] = "Runtime Nodes";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Runtime Nodes</h1>
        <p class="od-page-subtitle">Execution hosts available for contract releases.</p>
    </div>
    <button class="btn btn-primary js-open-runtime-node-setup" type="button" data-mode="new">Create runtime node</button>
</div>
        @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)
        @if (!Model.RuntimeNodes.Any())
        {
            <section class="od-panel">
                <p class="od-empty">No runtime nodes found.</p>
            </section>
        }
        else
        {
        <section class="od-list-shell">
            <div class="od-grid od-runtime-node-grid">
                @foreach (var node in Model.RuntimeNodes)
                {
                    var credentialReady = node.InboundCredentialStatus == ConnectionCredentialStatus.Active && node.OutboundCredentialStatus == ConnectionCredentialStatus.Active;
                    <article class="od-item-card od-runtime-node-card"
                             data-runtime-node-card
                             data-runtime-node-open
                             data-id="@node.Id"
                             data-name="@node.Name"
                             data-code="@node.Code"
                             data-environment-id="@node.EnvironmentId"
                             data-environment-name="@(node.Environment?.Name ?? node.EnvironmentName ?? "-")"
                             data-distribution-mode="@node.DistributionMode"
                             data-endpoint-base-uri="@node.EndpointBaseUri"
                             data-status="@node.Status"
                             data-enabled="@node.IsEnabled.ToString().ToLowerInvariant()"
                             data-description="@node.Description"
                             data-inbound-credential-status="@node.InboundCredentialStatus"
                             data-outbound-credential-status="@node.OutboundCredentialStatus">
                        <div class="od-item-top">
                            <div>
                                <h2 class="od-item-title">@node.Name</h2>
                                <p class="od-item-meta">@node.Code</p>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <span class="od-status @(node.IsEnabled && node.Status == RuntimeNodeStatus.Active ? "od-status-active" : "od-status-inactive")">@node.Status</span>
                                <div class="dropdown">
                                    <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Runtime node actions">
                                        <span aria-hidden="true">⋮</span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><button class="dropdown-item js-open-runtime-node-setup" type="button">Open setup</button></li>
                                        <li><button class="dropdown-item js-edit-runtime-node-from-card" type="button">Edit identity</button></li>
                                        <li><button class="dropdown-item js-generate-runtime-credentials-from-card" type="button">Generate design credentials</button></li>
                                        <li><button class="dropdown-item js-import-runtime-credentials-from-card" type="button">Import runtime credentials</button></li>
                                        <li>
                                            <form class="od-inline-form" method="post" asp-page-handler="ValidateConnection">
                                                <input type="hidden" name="runtimeNodeId" value="@node.Id" />
                                                <button class="dropdown-item" type="submit">Check connection</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="od-runtime-card-summary">
                            <div><span>Mode</span><strong>@node.DistributionMode</strong></div>
                            <div><span>Credentials</span><strong class="@(credentialReady ? "text-success" : "text-warning")">@(credentialReady ? "Ready" : "Pending")</strong></div>
                            <div><span>Environment</span><strong>@(node.Environment?.Name ?? node.EnvironmentName ?? "-")</strong></div>
                        </div>
                        <p class="od-item-description">@(string.IsNullOrWhiteSpace(node.Description) ? "No description." : node.Description)</p>
                    </article>
                }
            </div>
        </section>
        }

<div class="modal fade" id="runtimeNodeSetupModal" tabindex="-1" aria-labelledby="runtimeNodeSetupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="runtimeNodeSetupModalLabel">Runtime node setup</h5>
                    <p class="od-item-meta mb-0" id="runtimeNodeSetupSubtitle">Configure identity, policy, credentials, and connection.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body od-runtime-setup-body">
                <aside class="od-setup-rail" aria-label="Setup steps">
                    <button type="button" class="od-setup-step active" data-runtime-setup-step="identity">Identity</button>
                    <button type="button" class="od-setup-step" data-runtime-setup-step="policy">Policy</button>
                    <button type="button" class="od-setup-step" data-runtime-setup-step="runtimeCredentials">Runtime credentials</button>
                    <button type="button" class="od-setup-step" data-runtime-setup-step="designCredentials">Design credentials</button>
                    <button type="button" class="od-setup-step" data-runtime-setup-step="verify">Verify</button>
                </aside>
                <div class="od-setup-panels">
                    <section class="od-setup-panel active" data-runtime-setup-panel="identity">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Identity</h2>
                                <p class="od-item-meta">Name, code, environment, and description.</p>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm js-edit-runtime-node">Edit identity</button>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Name</span><strong id="setupRuntimeName">-</strong></div>
                            <div class="od-info-tile"><span>Code</span><strong id="setupRuntimeCode">-</strong></div>
                            <div class="od-info-tile"><span>Environment</span><strong id="setupRuntimeEnvironment">-</strong></div>
                            <div class="od-info-tile"><span>Status</span><strong id="setupRuntimeStatus">-</strong></div>
                        </div>
                        <div class="od-info-block">
                            <span>Description</span>
                            <p id="setupRuntimeDescription">-</p>
                        </div>
                    </section>
                    <section class="od-setup-panel" data-runtime-setup-panel="policy">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Distribution policy</h2>
                                <p class="od-item-meta">Choose who starts release movement.</p>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm js-edit-runtime-node">Edit policy</button>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Mode</span><strong id="setupRuntimeMode">-</strong></div>
                            <div class="od-info-tile"><span>Endpoint</span><strong id="setupRuntimeEndpoint">-</strong></div>
                            <div class="od-info-tile"><span>Enabled</span><strong id="setupRuntimeEnabled">-</strong></div>
                        </div>
                    </section>
                    <section class="od-setup-panel" data-runtime-setup-panel="runtimeCredentials">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Runtime credentials</h2>
                                <p class="od-item-meta">Required when Control Plane publishes releases to Runtime.</p>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm js-import-runtime-credentials">Import runtime credentials</button>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Status</span><strong id="setupRuntimeInboundStatus">-</strong></div>
                        </div>
                    </section>
                    <section class="od-setup-panel" data-runtime-setup-panel="designCredentials">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Design credentials</h2>
                                <p class="od-item-meta">Required when Runtime pulls releases from Control Plane.</p>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm js-generate-runtime-credentials">Generate design credentials</button>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Status</span><strong id="setupRuntimeOutboundStatus">-</strong></div>
                        </div>
                    </section>
                    <section class="od-setup-panel" data-runtime-setup-panel="verify">
                        <div class="od-section-head">
                            <div>
                                <h2 class="od-section-title">Verify connection</h2>
                                <p class="od-item-meta">Check that credentials and endpoint can communicate.</p>
                            </div>
                            <form class="d-inline" method="post" asp-page-handler="ValidateConnection">
                                <input type="hidden" name="runtimeNodeId" id="setupRuntimeValidateId" />
                                <button class="btn btn-primary btn-sm" type="submit">Check connection</button>
                            </form>
                        </div>
                        <div class="od-info-grid">
                            <div class="od-info-tile"><span>Credentials</span><strong id="setupRuntimeCredentialReadiness">-</strong></div>
                            <div class="od-info-tile"><span>Mode</span><strong id="setupRuntimeVerifyMode">-</strong></div>
                        </div>
                    </section>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="runtimeNodeModal" tabindex="-1" aria-hidden="true" data-show="@Model.ShowRuntimeNodeModal.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Runtime Node</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="knowl-message-box knowl-message-danger"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <partial name="_RuntimeNodeForm" model="Model" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save runtime node</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="generateCredentialsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="GenerateCredentials">
                <div class="modal-header">
                    <h5 class="modal-title">Generate Design credentials</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="CredentialInput.RuntimeNodeId" />
                    <p class="text-muted mb-3" data-runtime-node-name></p>
                    <label class="form-label" asp-for="CredentialInput.IssuerBaseUrl">KnOwl public base URL</label>
                    <input class="form-control" asp-for="CredentialInput.IssuerBaseUrl" placeholder="https://knowl-control-plane" />
                    <div class="form-text">Runtime imports these credentials to pull releases and acknowledge artifacts.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Generate credentials</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="generatedCredentialsModal" tabindex="-1" aria-hidden="true" data-show="@Model.ShowGeneratedCredentialModal.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Generated Design credentials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="knowl-message-box knowl-message-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span>Copy these credentials now. They include a secret and will not be shown again after closing this page.</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <label class="form-label">Base64</label>
                    <button type="button" class="btn btn-secondary btn-sm" data-copy-target="#generated-runtime-package-base64">Copy Base64</button>
                </div>
                <textarea id="generated-runtime-package-base64" class="form-control font-monospace" rows="5" readonly>@Model.GeneratedCredentialPackage?.Base64</textarea>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <label class="form-label">JSON</label>
                    <button type="button" class="btn btn-secondary btn-sm" data-copy-target="#generated-runtime-package-json">Copy JSON</button>
                </div>
                <textarea id="generated-runtime-package-json" class="form-control font-monospace" rows="12" readonly>@Model.GeneratedCredentialPackage?.Json</textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="importCredentialsModal" tabindex="-1" aria-hidden="true" data-show="@Model.ShowImportCredentialModal.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="ImportCredentials">
                <div class="modal-header">
                    <h5 class="modal-title">Import Runtime credentials</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="knowl-message-box knowl-message-danger"></div>
                    <input type="hidden" asp-for="CredentialImportInput.RuntimeNodeId" />
                    <p class="text-muted mb-3" data-runtime-node-name></p>
                    <label class="form-label" asp-for="CredentialImportInput.Package">Runtime credentials</label>
                    <textarea class="form-control font-monospace" asp-for="CredentialImportInput.Package" rows="10" placeholder="Paste Runtime credentials JSON"></textarea>
                    <span class="text-danger" asp-validation-for="CredentialImportInput.Package"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Import credentials</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const modal = document.getElementById('runtimeNodeModal');
    if (!modal) return;
    let currentRuntimeNode = null;
    const setupModal = document.getElementById('runtimeNodeSetupModal');
    const readNode = element => element?.closest('[data-runtime-node-card]');
    const setText = (id, value) => {
        const target = document.getElementById(id);
        if (target) target.textContent = value && `${value}`.trim() ? value : '-';
    };
    const showSetupPanel = key => {
        setupModal?.querySelectorAll('[data-runtime-setup-step]').forEach(step => step.classList.toggle('active', step.dataset.runtimeSetupStep === key));
        setupModal?.querySelectorAll('[data-runtime-setup-panel]').forEach(panel => panel.classList.toggle('active', panel.dataset.runtimeSetupPanel === key));
    };
    const fillSetup = node => {
        currentRuntimeNode = node || null;
        const isNew = !currentRuntimeNode;
        setText('runtimeNodeSetupModalLabel', isNew ? 'Create runtime node' : currentRuntimeNode.dataset.name);
        setText('runtimeNodeSetupSubtitle', isNew ? 'Create the node first, then complete credentials and verification.' : `${currentRuntimeNode.dataset.code || '-'} | ${currentRuntimeNode.dataset.distributionMode || '-'}`);
        setText('setupRuntimeName', currentRuntimeNode?.dataset.name);
        setText('setupRuntimeCode', currentRuntimeNode?.dataset.code);
        setText('setupRuntimeEnvironment', currentRuntimeNode?.dataset.environmentName);
        setText('setupRuntimeStatus', currentRuntimeNode?.dataset.status);
        setText('setupRuntimeDescription', currentRuntimeNode?.dataset.description);
        setText('setupRuntimeMode', currentRuntimeNode?.dataset.distributionMode);
        setText('setupRuntimeEndpoint', currentRuntimeNode?.dataset.endpointBaseUri);
        setText('setupRuntimeEnabled', currentRuntimeNode?.dataset.enabled === 'true' ? 'Yes' : isNew ? '-' : 'No');
        setText('setupRuntimeInboundStatus', currentRuntimeNode?.dataset.inboundCredentialStatus);
        setText('setupRuntimeOutboundStatus', currentRuntimeNode?.dataset.outboundCredentialStatus);
        setText('setupRuntimeVerifyMode', currentRuntimeNode?.dataset.distributionMode);
        const ready = currentRuntimeNode?.dataset.inboundCredentialStatus === 'Active' && currentRuntimeNode?.dataset.outboundCredentialStatus === 'Active';
        setText('setupRuntimeCredentialReadiness', isNew ? '-' : ready ? 'Ready' : 'Pending');
        const validateInput = document.getElementById('setupRuntimeValidateId');
        if (validateInput) validateInput.value = currentRuntimeNode?.dataset.id || '';
        setupModal?.querySelectorAll('.js-import-runtime-credentials, .js-generate-runtime-credentials, #setupRuntimeValidateId + button')
            .forEach(button => button.disabled = isNew);
        showSetupPanel('identity');
        bootstrap.Modal.getOrCreateInstance(setupModal).show();
    };

    document.querySelectorAll('[data-runtime-node-open]').forEach(card => {
        card.addEventListener('click', event => {
            if (event.target.closest('a, button, input, select, textarea, form, .dropdown-menu')) {
                return;
            }

            fillSetup(card);
        });
    });
    document.querySelectorAll('.js-open-runtime-node-setup').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            fillSetup(button.dataset.mode === 'new' ? null : readNode(button));
        });
    });
    document.querySelectorAll('.js-edit-runtime-node-from-card').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            const node = readNode(button);
            const trigger = document.createElement('button');
            trigger.dataset.mode = 'edit';
            if (node) {
                Object.assign(trigger.dataset, node.dataset);
            }

            bootstrap.Modal.getOrCreateInstance(modal).show(trigger);
        });
    });
    document.querySelectorAll('.js-import-runtime-credentials-from-card').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            const node = readNode(button);
            if (!node) return;
            const trigger = document.createElement('button');
            trigger.dataset.id = node.dataset.id;
            trigger.dataset.name = node.dataset.name;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('importCredentialsModal')).show(trigger);
        });
    });
    document.querySelectorAll('.js-generate-runtime-credentials-from-card').forEach(button => {
        button.addEventListener('click', event => {
            event.stopPropagation();
            const node = readNode(button);
            if (!node) return;
            const trigger = document.createElement('button');
            trigger.dataset.id = node.dataset.id;
            trigger.dataset.name = node.dataset.name;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('generateCredentialsModal')).show(trigger);
        });
    });
    setupModal?.querySelectorAll('[data-runtime-setup-step]').forEach(step => {
        step.addEventListener('click', () => showSetupPanel(step.dataset.runtimeSetupStep));
    });
    setupModal?.querySelectorAll('.js-edit-runtime-node').forEach(button => {
        button.addEventListener('click', () => {
            const trigger = document.createElement('button');
            trigger.dataset.mode = currentRuntimeNode ? 'edit' : 'new';
            if (currentRuntimeNode) {
                Object.assign(trigger.dataset, currentRuntimeNode.dataset);
            }
            bootstrap.Modal.getOrCreateInstance(setupModal).hide();
            setTimeout(() => {
                bootstrap.Modal.getOrCreateInstance(modal).show(trigger);
            }, 150);
        });
    });
    setupModal?.querySelector('.js-import-runtime-credentials')?.addEventListener('click', () => {
        if (!currentRuntimeNode) return;
        const trigger = document.createElement('button');
        trigger.dataset.id = currentRuntimeNode.dataset.id;
        trigger.dataset.name = currentRuntimeNode.dataset.name;
        bootstrap.Modal.getOrCreateInstance(setupModal).hide();
        setTimeout(() => bootstrap.Modal.getOrCreateInstance(document.getElementById('importCredentialsModal')).show(trigger), 150);
    });
    setupModal?.querySelector('.js-generate-runtime-credentials')?.addEventListener('click', () => {
        if (!currentRuntimeNode) return;
        const trigger = document.createElement('button');
        trigger.dataset.id = currentRuntimeNode.dataset.id;
        trigger.dataset.name = currentRuntimeNode.dataset.name;
        bootstrap.Modal.getOrCreateInstance(setupModal).hide();
        setTimeout(() => bootstrap.Modal.getOrCreateInstance(document.getElementById('generateCredentialsModal')).show(trigger), 150);
    });
    if (modal.dataset.show === 'true') {
        bootstrap.Modal.getOrCreateInstance(modal).show();
    }
    modal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const isEdit = button?.dataset.mode === 'edit';
        const setValue = (name, value) => {
            const input = modal.querySelector(`[name="${name}"]`);
            if (!input) return;
            const nextValue = value || '';
            input.value = nextValue;
            if (input.tagName === 'SELECT' && input.value !== nextValue) {
                const matchingOption = Array.from(input.options).find(option => option.text === nextValue);
                if (matchingOption) input.value = matchingOption.value;
            }
        };
        setValue('Input.Id', isEdit ? button.dataset.id : '');
        setValue('Input.Name', isEdit ? button.dataset.name : '');
        setValue('Input.Code', isEdit ? button.dataset.code : '');
        setValue('Input.EnvironmentId', isEdit ? button.dataset.environmentId : '');
        setValue('Input.DistributionMode', isEdit ? button.dataset.distributionMode : 'Pull');
        setValue('Input.EndpointBaseUri', isEdit ? button.dataset.endpointBaseUri : '');
        setValue('Input.Status', isEdit ? button.dataset.status : 'Active');
        setValue('Input.Description', isEdit ? button.dataset.description : '');
        const enabled = modal.querySelector('[name="Input.IsEnabled"]');
        if (enabled) enabled.checked = isEdit ? button.dataset.enabled === 'true' : true;
    });

    const generated = document.getElementById('generatedCredentialsModal');
    if (generated?.dataset.show === 'true') {
        bootstrap.Modal.getOrCreateInstance(generated).show();
    }

    const configureCredentialModal = event => {
        const button = event.relatedTarget;
        const modal = event.currentTarget;
        if (!button?.dataset.id) {
            return;
        }

        const id = button.dataset.id;
        const name = button.dataset.name || '';
        modal.querySelectorAll('[name$=".RuntimeNodeId"]').forEach(input => input.value = id);
        modal.querySelectorAll('[data-runtime-node-name]').forEach(label => label.textContent = name ? `Runtime node: ${name}` : '');
    };

    document.getElementById('generateCredentialsModal')?.addEventListener('show.bs.modal', configureCredentialModal);
    const importModal = document.getElementById('importCredentialsModal');
    importModal?.addEventListener('show.bs.modal', configureCredentialModal);
    if (importModal?.dataset.show === 'true') {
        bootstrap.Modal.getOrCreateInstance(importModal).show();
    }

    document.querySelectorAll('[data-copy-target]').forEach(button => {
        button.addEventListener('click', async () => {
            const target = document.querySelector(button.dataset.copyTarget || '');
            const value = target?.value || target?.textContent || '';
            if (!value.trim()) return;

            const original = button.textContent;
            try {
                await navigator.clipboard.writeText(value);
            } catch {
                target.focus();
                target.select?.();
                document.execCommand('copy');
            }

            button.textContent = 'Copied';
            window.setTimeout(() => {
                button.textContent = original;
            }, 1500);
        });
    });
})();
</script>
}
