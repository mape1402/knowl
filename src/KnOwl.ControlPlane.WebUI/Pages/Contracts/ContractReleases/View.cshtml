@page
@using KnOwl.Contracts.Artifacts
@using KnOwl.Contracts.Distribution
@using KnOwl.ControlPlane.Distribution.Core
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.ContractReleases.ViewModel
@{
    ViewData["Title"] = "Release Details";
    var hasExecutableTargets = Model.Release?.Targets.Any(target =>
        target.Status is ContractReleaseTargetStatus.Pending
            or ContractReleaseTargetStatus.PushScheduled
            or ContractReleaseTargetStatus.AvailableForPull
            or ContractReleaseTargetStatus.Failed) == true;

    string ReleaseStatusClass(ContractReleaseStatus status) => status switch
    {
        ContractReleaseStatus.Completed => "knowl-status knowl-status-deployed",
        ContractReleaseStatus.Failed or ContractReleaseStatus.Canceled => "knowl-status knowl-status-archived",
        ContractReleaseStatus.InProgress => "knowl-status knowl-status-review",
        ContractReleaseStatus.Draft => "knowl-status knowl-status-draft",
        _ => "knowl-status"
    };

    string TargetStatusClass(ContractReleaseTargetStatus status) => status switch
    {
        ContractReleaseTargetStatus.Activated => "knowl-stage knowl-stage-done",
        ContractReleaseTargetStatus.Failed or ContractReleaseTargetStatus.Cancelled => "knowl-stage knowl-stage-failed",
        ContractReleaseTargetStatus.AvailableForPull
            or ContractReleaseTargetStatus.PushScheduled
            or ContractReleaseTargetStatus.InProgress
            or ContractReleaseTargetStatus.Delivered
            or ContractReleaseTargetStatus.Acknowledged => "knowl-stage knowl-stage-pending",
        _ => "knowl-stage"
    };

    string DistributionLabel(DistributionMode? mode) => mode switch
    {
        DistributionMode.Push => "Control Plane pushes",
        DistributionMode.Pull => "Runtime pulls",
        DistributionMode.Hybrid => "Both directions",
        _ => "Unknown mode"
    };

    string ContractGroupName(IEnumerable<ContractReleaseItem> items)
    {
        var ordered = items.OrderBy(ArtifactTypeOrder).ToArray();
        var primary = ordered.FirstOrDefault(x => x.Artifact?.ArtifactType == ContractArtifactType.Event)
            ?? ordered.FirstOrDefault(x => x.Artifact?.ArtifactType == ContractArtifactType.Command)
            ?? ordered.FirstOrDefault(x => x.Artifact?.ArtifactType == ContractArtifactType.CommandRequest)
            ?? ordered.FirstOrDefault()
            ?? throw new InvalidOperationException("Release artifact group is empty.");

        var name = primary.Artifact?.Name ?? "Unknown contract";
        if (!ordered.Any(x => x.Artifact?.ArtifactType is ContractArtifactType.Command or ContractArtifactType.CommandRequest or ContractArtifactType.CommandReply))
        {
            return name;
        }

        foreach (var suffix in new[] { " Request", " Reply" })
        {
            if (name.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                return name[..^suffix.Length].TrimEnd();
            }
        }

        return name;
    }

    int ArtifactTypeOrder(ContractReleaseItem item)
        => item.Artifact?.ArtifactType switch
        {
            ContractArtifactType.Event => 0,
            ContractArtifactType.Command => 1,
            ContractArtifactType.CommandRequest => 2,
            ContractArtifactType.CommandReply => 3,
            _ => 4
        };
}

<section class="dashboard-section">
    <div class="release-page-head">
        <div>
            <h1>Release Details</h1>
            <p>@Model.Release?.Name</p>
        </div>
        <div class="d-flex gap-2">
            @if (hasExecutableTargets && Model.Release is not null)
            {
                <form method="post" asp-page-handler="PushAll">
                    <input type="hidden" name="id" value="@Model.Release.Id" />
                    <button type="submit" class="btn btn-primary btn-sm">Distribute all</button>
                </form>
            }
            <a class="btn btn-secondary btn-sm" asp-page="/Contracts/ContractReleases/Index">Back</a>
        </div>
    </div>

    @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

    @if (Model.Release is not null)
    {
        <div class="release-detail-summary">
            <div>
                <span class="event-meta-label">Status</span>
                <p><span class="@ReleaseStatusClass(Model.Release.Status)">@Model.Release.Status</span></p>
            </div>
            <div>
                <span class="event-meta-label">Artifacts</span>
                <p>@Model.Release.Items.Count</p>
            </div>
            <div>
                <span class="event-meta-label">Targets</span>
                <p>@Model.Release.Targets.Count</p>
            </div>
            <div>
                <span class="event-meta-label">Created</span>
                <p>@Model.Release.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            </div>
        </div>

        <div class="release-artifact-board">
            @foreach (var contractGroup in Model.Release.Items
                .GroupBy(item => new
                {
                    DefinitionId = item.Artifact?.DefinitionId ?? Guid.Empty,
                    VersionId = item.Artifact?.VersionId ?? Guid.Empty,
                    Topic = item.Artifact?.Topic ?? string.Empty,
                    VersionNumber = item.Artifact?.VersionNumber ?? string.Empty
                })
                .OrderBy(group => group.Key.Topic)
                .ThenBy(group => group.Key.VersionNumber))
            {
                var groupItems = contractGroup.ToArray();
                var contractName = ContractGroupName(groupItems);
                var groupItemIds = groupItems.Select(x => x.Id).ToHashSet();
                var groupTargets = Model.Release.Targets
                    .Where(target => groupItemIds.Contains(target.ReleaseItemId) || groupItems.Any(item => item.ArtifactId == target.ArtifactId))
                    .OrderBy(target => target.RuntimeNode?.Name)
                    .ThenBy(target => target.Artifact?.ArtifactType)
                    .ToArray();

                <article class="release-artifact-card">
                    <div class="release-artifact-card-head">
                        <div>
                            <span class="knowl-status knowl-status-approved">@(groupItems.Any(x => x.Artifact?.ArtifactType.ToString().StartsWith("Command") == true) ? "Command" : "Event")</span>
                            <h2>@contractName</h2>
                            <p>@contractGroup.Key.Topic @contractGroup.Key.VersionNumber</p>
                        </div>
                        <div class="release-contract-tags">
                            @foreach (var item in groupItems.OrderBy(x => x.Artifact?.ArtifactType))
                            {
                                <span>@item.Artifact?.ArtifactType</span>
                            }
                        </div>
                    </div>

                    <div class="release-runtime-stages">
                        @foreach (var target in groupTargets)
                        {
                            var canPushRuntime = target.RuntimeNode?.DistributionMode is DistributionMode.Push or DistributionMode.Hybrid;
                            var canRetryTarget = target.Status is ContractReleaseTargetStatus.Pending
                                or ContractReleaseTargetStatus.PushScheduled
                                or ContractReleaseTargetStatus.AvailableForPull
                                or ContractReleaseTargetStatus.Failed;
                            var canPush = canPushRuntime && canRetryTarget;
                            var lastAttempt = target.Attempts.OrderByDescending(x => x.StartedAtUtc).FirstOrDefault();

                            <div class="@TargetStatusClass(target.Status)">
                                <div class="knowl-stage-name">@target.RuntimeNode?.Name</div>
                                <div class="knowl-stage-meta">@target.RuntimeNode?.Code - @DistributionLabel(target.RuntimeNode?.DistributionMode)</div>
                                <div class="knowl-stage-meta">@target.Artifact?.ArtifactType</div>
                                <div class="knowl-stage-status">@target.Status</div>
                                @if (!string.IsNullOrWhiteSpace(target.FailureReason) || lastAttempt is not null)
                                {
                                    <div class="knowl-stage-error">
                                        @(lastAttempt?.ErrorMessage ?? target.FailureReason ?? $"{lastAttempt?.Action} {(lastAttempt?.Succeeded == true ? "OK" : "FAIL")}")
                                    </div>
                                }
                                @if (canPush)
                                {
                                    <form method="post" asp-page-handler="PushTarget" class="mt-2">
                                        <input type="hidden" name="id" value="@Model.Release.Id" />
                                        <input type="hidden" name="targetId" value="@target.Id" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">Push</button>
                                    </form>
                                }
                                else if (target.Status == ContractReleaseTargetStatus.Activated)
                                {
                                    <div class="knowl-stage-note">Promoted</div>
                                }
                                else if (target.RuntimeNode?.DistributionMode == DistributionMode.Pull)
                                {
                                    <div class="knowl-stage-note">Pull from runtime</div>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
