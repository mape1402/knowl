@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.ContractReleases.IndexModel
@{
    ViewData["Title"] = "Releases";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
    var releaseOptionsJson = System.Text.Json.JsonSerializer.Serialize(Model.ReleaseOptions, jsonOptions);
    var selectedArtifactIdsJson = System.Text.Json.JsonSerializer.Serialize(Model.Input.ArtifactIds, jsonOptions);

    string ReleaseStatusClass(string status) => status switch
    {
        "Completed" => "knowl-status knowl-status-deployed",
        "Failed" or "Canceled" => "knowl-status knowl-status-archived",
        "InProgress" => "knowl-status knowl-status-review",
        "Draft" => "knowl-status knowl-status-draft",
        _ => "knowl-status"
    };

    string DistributionLabel(string mode) => mode switch
    {
        "Push" => "Control Plane pushes",
        "Pull" => "Runtime pulls",
        "Hybrid" => "Both directions",
        _ => string.IsNullOrWhiteSpace(mode) ? "Unknown mode" : mode
    };
}

<section class="dashboard-section">
    <div class="release-page-head">
        <div>
            <h1>Contract Releases</h1>
            <p>Bundle released Event and Command artifacts and distribute them to runtime nodes.</p>
        </div>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#releaseModal">
            <i class="bi bi-plus-lg"></i> New release
        </button>
    </div>

    @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

    <form method="get" class="od-search-bar">
        <label class="od-search-field" for="releases-search">
            <span>Search releases</span>
            <input id="releases-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, status, contract, runtime node, target status" />
        </label>
        <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-secondary" asp-page="/Contracts/ContractReleases/Index">Clear</a>
            <span class="od-search-count">@Model.ReleaseCards.Count of @Model.TotalReleaseCards</span>
        }
    </form>

    @if (Model.ReleaseCards.Count == 0)
    {
        <div class="events-empty-state">
            <i class="bi bi-box-seam"></i>
            <h3>@(string.IsNullOrWhiteSpace(Model.Search) ? "No releases yet" : "No matching releases")</h3>
            <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "Deploy an Event or Command version, then create a release." : "Try another name, status, contract, runtime node, or target status.")</p>
            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#releaseModal">Create release</button>
            }
        </div>
    }
    else
    {
        <div class="release-board">
            @foreach (var release in Model.ReleaseCards)
            {
                <article class="release-card" data-open-url="@Url.Page("/Contracts/ContractReleases/View", new { id = release.Id })">
                    <div class="release-card-main">
                        <div class="release-card-head">
                            <div>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="@ReleaseStatusClass(release.Status)">@release.Status</span>
                                    <h2>@release.Name</h2>
                                </div>
                                <p class="release-card-sub">@release.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                            </div>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Release actions">...</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Contracts/ContractReleases/View" asp-route-id="@release.Id">Open details</a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="release-metrics">
                            <span>@release.ArtifactCount artifacts</span>
                            <span>@release.TargetCount targets</span>
                            <span>@release.ActivatedCount promoted</span>
                            <span>@release.PendingCount pending</span>
                            <span>@release.FailedCount failed</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<div class="modal fade" id="releaseModal" tabindex="-1" aria-hidden="true" data-show="@Model.ShowReleaseModal.ToString().ToLowerInvariant()" data-initial-step="@Model.InitialReleaseStep">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" id="releaseWizardForm">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">New release</h5>
                        <div class="release-step-indicator">
                            <span class="active" data-step-label="1">1. Artifacts</span>
                            <span data-step-label="2">2. Runtime nodes</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="knowl-message-box knowl-message-danger"></div>
                    <div class="release-step" data-step="1">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" asp-for="Input.Name">Release name</label>
                                <input class="form-control" asp-for="Input.Name" placeholder="Release 2026-09-19" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" asp-for="Input.Description">Description</label>
                                <input class="form-control" asp-for="Input.Description" placeholder="Optional notes" />
                            </div>
                        </div>

                        @if (Model.ReleaseOptions.Count == 0)
                        {
                            <div class="knowl-message-box mb-0">
                                <i class="bi bi-info-circle"></i>
                                <span>No artifacts are ready yet. Deploy an approved Event or Command version first.</span>
                            </div>
                        }
                        else
                        {
                            <div class="release-builder">
                                <div class="release-builder-picker">
                                    <label class="form-label" for="releaseArtifactPicker">Add artifact</label>
                                    <div class="input-group">
                                        <select class="form-select" id="releaseArtifactPicker">
                                            <option value="">Select Event or Command version</option>
                                            @foreach (var option in Model.ReleaseOptions)
                                            {
                                                <option value="@option.Key">
                                                    @option.ContractType - @option.Name - @option.VersionNumber
                                                </option>
                                            }
                                        </select>
                                        <button type="button" class="btn btn-primary" id="releaseAddArtifactButton">
                                            <i class="bi bi-plus-lg"></i> Add
                                        </button>
                                    </div>
                                    <p class="od-item-meta mt-2">Commands add request and reply artifacts together when both exist.</p>
                                </div>
                                <div class="release-builder-selected">
                                    <div class="od-section-head mb-2">
                                        <div>
                                            <h2 class="od-section-title">Selected artifacts</h2>
                                            <p class="od-item-meta">Add only the artifacts that belong in this release.</p>
                                        </div>
                                    </div>
                                    <div id="releaseSelectedArtifacts" class="release-selected-list"></div>
                                    <div id="releaseArtifactInputs"></div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="release-step d-none" data-step="2">
                        @if (Model.RuntimeNodes.Count == 0)
                        {
                            <div class="knowl-message-box mb-0">
                                <i class="bi bi-info-circle"></i>
                                <span>No active runtime nodes are available. Create or enable a runtime node first.</span>
                            </div>
                        }
                        else
                        {
                            <div class="release-runtime-environments">
                                @foreach (var group in Model.RuntimeEnvironmentGroups)
                                {
                                    <section class="release-runtime-environment">
                                        <div class="release-runtime-environment-head">
                                            <h3>@group.Name</h3>
                                            <span>@group.Nodes.Count nodes</span>
                                        </div>
                                        <div class="release-picker-grid runtime-picker-grid">
                                            @foreach (var node in group.Nodes)
                                            {
                                                var inputId = $"node_{node.Id:N}";
                                                <label class="release-picker-card" for="@inputId">
                                                    <input id="@inputId" type="checkbox" name="Input.RuntimeNodeIds" value="@node.Id" checked="@Model.Input.RuntimeNodeIds.Contains(node.Id)" />
                                                    <span class="release-picker-title">@node.Name</span>
                                                    <span class="release-picker-meta">@node.Code - @DistributionLabel(node.DistributionMode.ToString())</span>
                                                    <span class="release-picker-meta">@(node.Environment?.Name ?? node.EnvironmentName ?? "-")</span>
                                                </label>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-secondary d-none" id="releaseBackStep">Back</button>
                    <button type="button" class="btn btn-primary" id="releaseNextStep">Next</button>
                    <button type="submit" class="btn btn-primary d-none" id="releaseSubmit">Create and distribute</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    let step = 1;
    const modal = document.getElementById('releaseModal');
    const next = document.getElementById('releaseNextStep');
    const back = document.getElementById('releaseBackStep');
    const submit = document.getElementById('releaseSubmit');
    const picker = document.getElementById('releaseArtifactPicker');
    const addButton = document.getElementById('releaseAddArtifactButton');
    const selectedHost = document.getElementById('releaseSelectedArtifacts');
    const inputHost = document.getElementById('releaseArtifactInputs');
    const nodeChecks = () => Array.from(document.querySelectorAll('[name="Input.RuntimeNodeIds"]'));
    const options = @Html.Raw(releaseOptionsJson);
    const initialSelectedArtifactIds = @Html.Raw(selectedArtifactIdsJson);
    const selectedKeys = new Set();
    const selectedArtifactIds = new Set(initialSelectedArtifactIds.map(x => x.toLowerCase()));
    const optionByKey = new Map(options.map(option => [option.key, option]));

    const escapeHtml = value => (value ?? '').toString()
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const hasSelectedArtifacts = () => selectedKeys.size > 0;
    const hasSelectedRuntimeNodes = () => nodeChecks().some(x => x.checked);

    const renderSelectedArtifacts = () => {
        if (!selectedHost || !inputHost) return;
        inputHost.innerHTML = '';
        if (selectedKeys.size === 0) {
            selectedHost.innerHTML = '<div class="release-selected-empty">No artifacts selected.</div>';
        } else {
            selectedHost.innerHTML = Array.from(selectedKeys).map(key => {
                const option = optionByKey.get(key);
                if (!option) return '';
                option.artifactIds.forEach(id => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'Input.ArtifactIds';
                    input.value = id;
                    inputHost.appendChild(input);
                });
                const tags = option.artifacts.map(artifact => `<span>${escapeHtml(artifact.artifactType)}</span>`).join('');
                return `
                    <article class="release-selected-item">
                        <div>
                            <strong>${escapeHtml(option.name)}</strong>
                            <span>${escapeHtml(option.contractType)} - ${escapeHtml(option.topic)} - ${escapeHtml(option.versionNumber)}</span>
                            <div class="release-contract-tags">${tags}</div>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm" data-remove-release-artifact="${escapeHtml(key)}">Remove</button>
                    </article>`;
            }).join('');
        }

        selectedHost.querySelectorAll('[data-remove-release-artifact]').forEach(button => {
            button.addEventListener('click', () => {
                selectedKeys.delete(button.dataset.removeReleaseArtifact);
                renderSelectedArtifacts();
                updateActions();
            });
        });
    };

    const updateActions = () => {
        if (next) next.disabled = step === 1 && !hasSelectedArtifacts();
        if (submit) submit.disabled = !hasSelectedRuntimeNodes() || !hasSelectedArtifacts();
        document.querySelectorAll('.release-picker-card').forEach(card => {
            const input = card.querySelector('input');
            card.classList.toggle('selected', Boolean(input?.checked));
        });
    };

    const setStep = value => {
        step = value;
        document.querySelectorAll('.release-step').forEach(x => x.classList.toggle('d-none', x.dataset.step !== String(step)));
        document.querySelectorAll('[data-step-label]').forEach(x => x.classList.toggle('active', x.dataset.stepLabel === String(step)));
        back?.classList.toggle('d-none', step === 1);
        next?.classList.toggle('d-none', step === 2);
        submit?.classList.toggle('d-none', step !== 2);
        updateActions();
    };

    addButton?.addEventListener('click', () => {
        const key = picker?.value || '';
        if (!key || !optionByKey.has(key)) return;
        selectedKeys.add(key);
        if (picker) picker.value = '';
        renderSelectedArtifacts();
        updateActions();
    });

    options.forEach(option => {
        if (option.artifactIds.every(id => selectedArtifactIds.has(id.toLowerCase()))) {
            selectedKeys.add(option.key);
        }
    });

    next?.addEventListener('click', () => {
        if (hasSelectedArtifacts()) setStep(2);
    });
    back?.addEventListener('click', () => setStep(1));
    nodeChecks().forEach(x => x.addEventListener('change', updateActions));
    renderSelectedArtifacts();

    if (modal?.dataset.show === 'true') {
        bootstrap.Modal.getOrCreateInstance(modal).show();
        setStep(Number(modal.dataset.initialStep || '1'));
    }
    modal?.addEventListener('hidden.bs.modal', () => setStep(1));
    updateActions();
})();
</script>
}
