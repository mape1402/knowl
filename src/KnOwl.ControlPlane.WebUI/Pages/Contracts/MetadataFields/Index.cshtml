@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.MetadataFields.IndexModel
@{
    ViewData["Title"] = "Custom Fields";
    var designerUrl = "/buttermorph/metadata-fields/designer?mode=create&popup=true";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Custom Fields</h1>
        <p class="od-page-subtitle">Dynamic fields available for schema and field metadata.</p>
    </div>
            <button type="button"
            class="btn btn-primary"
                    data-buttermorph-url="@designerUrl"
                    data-buttermorph-title="New custom field"
                    data-buttermorph-redirect-url="@Url.Page("/Contracts/MetadataFields/Index")">
                <i class="bi bi-plus-lg"></i> New field
            </button>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="metadata-fields-search">
        <span>Search custom fields</span>
        <input id="metadata-fields-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, key, description, data type, applies to, version" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Contracts/MetadataFields/Index">Clear</a>
        <span class="od-search-count">@Model.Fields.Count of @Model.TotalFields</span>
    }
</form>

@if (!Model.Fields.Any())
{
    <section class="od-panel">
        <p class="od-empty">@(string.IsNullOrWhiteSpace(Model.Search) ? "No custom fields found." : "No custom fields match the current search.")</p>
    </section>
}
else
{
    <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var item in Model.Fields)
            {
                <article class="od-item-card"
                         data-open-url="@Url.Page("/Contracts/MetadataFields/View", new { id = item.Id })">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.Name</h2>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            @if (!item.IsActive)
                            {
                                <span class="od-status od-status-inactive">Inactive</span>
                            }
                            else if (item.IsRequired)
                            {
                                <span class="od-status od-status-inreview">Required</span>
                            }
                            else
                            {
                                <span class="od-status od-status-active">Active</span>
                            }
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Custom field actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Contracts/MetadataFields/View" asp-route-id="@item.Id">Open</a>
                                    </li>
                                    <li>
                                        <button type="button"
                                                class="dropdown-item"
                                                data-buttermorph-url="/buttermorph/metadata-fields/designer?context=@KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.NewMetadataFieldVersion(item.Id)&mode=create&popup=true"
                                                data-buttermorph-title="New version of @item.Name"
                                                data-buttermorph-redirect-url="@Url.Page("/Contracts/MetadataFields/View", new { id = item.Id })">
                                            New version
                                        </button>
                                    </li>
                                    @if (item.IsActive)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" class="od-inline-form" onsubmit="return confirm('Deactivate this custom field?');">
                                                <button type="submit" class="dropdown-item text-danger">Deactivate</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                    <div class="od-card-footer">
                        <span class="od-card-date">Created @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </article>
            }
        </div>
    </section>
}

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}

