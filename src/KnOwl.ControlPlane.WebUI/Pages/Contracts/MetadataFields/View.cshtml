@page "{id:guid}"
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.MetadataFields.ViewModel
@{
    ViewData["Title"] = Model.Field?.Name ?? "Custom Field";
    var field = Model.Field!;
    var designerUrl = $"/buttermorph/metadata-fields/designer?context={Model.ButterMorphContext}&mode=create&popup=true";
}

<section class="dashboard-section">
    <div class="platform-card event-detail-card">
        <div class="platform-card-header">
            <span>Custom Field Details</span>
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-buttermorph-url="@designerUrl"
                        data-buttermorph-title="New version of @field.Name"
                        data-buttermorph-redirect-url="@Url.Page("/Contracts/MetadataFields/View", new { id = field.Id })">
                    <i class="bi bi-plus-lg"></i> New version
                </button>
                <a class="btn btn-secondary btn-sm" asp-page="/Contracts/MetadataFields/Index">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        @if (Model.Field is null)
        {
            <div class="events-empty-state"><h3>Custom field not found</h3></div>
        }
        else
        {
            <div class="event-meta-grid">
                <div>
                    <span class="event-meta-label">Name</span>
                    <p class="event-meta-value">@field.Name</p>
                </div>
                <div>
                    <span class="event-meta-label">Key</span>
                    <p class="event-meta-value">@field.Key</p>
                </div>
                <div>
                    <span class="event-meta-label">Versions</span>
                    <p class="event-meta-value">@field.Versions.Count</p>
                </div>
            </div>

            <div class="mt-3">
                <span class="event-meta-label">Description</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(field.Description) ? "-" : field.Description)</p>
            </div>

            <div class="mt-3">
                <span class="event-meta-label">Available Versions</span>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    @foreach (var version in field.Versions.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <a class="btn btn-secondary btn-sm @(Model.SelectedVersion?.Id == version.Id ? "active" : "")"
                           asp-page="/Contracts/MetadataFields/View"
                           asp-route-id="@field.Id"
                           asp-route-version="@version.VersionNumber">
                            @version.VersionNumber
                        </a>
                    }
                </div>
            </div>

            <div class="mt-3 event-detail-schema">
                <span class="event-meta-label">Custom field definition (@Model.SelectedVersion?.VersionNumber)</span>
                <p class="event-meta-value"><strong>Comment:</strong> @(string.IsNullOrWhiteSpace(Model.SelectedVersion?.Comment) ? "-" : Model.SelectedVersion?.Comment)</p>
                <pre class="contract-json-output">@Model.FormattedDefinitionJson</pre>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}

