@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.IndexModel
@{
    ViewData["Title"] = "Types";
    var designerUrl = "/buttermorph/schema-types/designer?context=type:new&mode=create&popup=true";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Data Types</h1>
        <p class="od-page-subtitle">Basic and custom types available for JSON payloads.</p>
    </div>
            <button type="button"
            class="btn btn-primary"
                    data-buttermorph-url="@designerUrl"
                    data-buttermorph-title="New data type"
                    data-buttermorph-redirect-url="@Url.Page("/Contracts/Types/Index")">
                <i class="bi bi-plus-lg"></i> New data type
            </button>
</div>

        <section class="od-list-shell">
        <div class="od-grid">
            @foreach (var item in Model.Types)
            {
                <article class="od-item-card"
                         data-open-url="@Url.Page("/Contracts/Types/View", new { id = item.Id })">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.Name</h2>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            @if (item.IsSystem)
                            {
                                <span class="od-status od-status-inreview">System</span>
                            }
                            else if (!item.IsActive)
                            {
                                <span class="od-status od-status-inactive">Inactive</span>
                            }
                            else
                            {
                                <span class="od-status od-status-active">Active</span>
                            }
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Data type actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Contracts/Types/View" asp-route-id="@item.Id">Open</a>
                                    </li>
                                    @if (!item.IsSystem)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-page="/Contracts/Types/NewVersion" asp-route-id="@item.Id">New version</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Contracts/Types/Edit" asp-route-id="@item.Id">Edit</a>
                                        </li>
                                        @if (item.IsActive)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" class="od-inline-form" onsubmit="return confirm('Deactivate this type?');">
                                                    <button type="submit" class="dropdown-item text-danger">Deactivate</button>
                                                </form>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                    <div class="od-card-footer">
                        <span class="od-card-date">Created @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </article>
            }
        </div>
        </section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}

