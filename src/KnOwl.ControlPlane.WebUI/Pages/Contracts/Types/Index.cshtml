@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.IndexModel
@{
    ViewData["Title"] = "Types";
    var designerUrl = "/buttermorph/schema-types/designer?context=type:new&mode=create&popup=true";
}

<section class="dashboard-section">
    <div class="platform-card">
        <div class="platform-card-header">
            <span>Data Types</span>
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-buttermorph-url="@designerUrl"
                    data-buttermorph-title="New data type"
                    data-buttermorph-redirect-url="@Url.Page("/Contracts/Types/Index")">
                <i class="bi bi-plus-lg"></i> New data type
            </button>
        </div>

        <p class="event-editor-intro">Basic and custom types available for JSON payloads.</p>

        <div class="events-list compact-contract-list">
            @foreach (var item in Model.Types)
            {
                var latest = item.Versions.OrderByDescending(x => x.CreatedAtUtc).FirstOrDefault();
                var latestDefinition = latest is null ? null : KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.ViewModel.ReadTypeDefinition(latest.DefinitionJson);
                <article class="event-list-card">
                    <h3 class="event-list-title">
                        @item.Name
                        @if (item.IsSystem)
                        {
                            <span class="badge text-bg-secondary">System</span>
                        }
                        else if (!item.IsActive)
                        {
                            <span class="badge text-bg-warning">Inactive</span>
                        }
                    </h3>
                    <p class="event-list-topic">@(latestDefinition?.BaseType ?? "-")</p>
                    <div class="event-list-meta">
                        <span>Versions: @item.Versions.Count</span>
                        <span>Latest: @(latest?.VersionNumber ?? "-")</span>
                        <span>Created: @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    <div class="event-list-actions">
                        <a class="btn btn-secondary btn-sm" asp-page="/Contracts/Types/View" asp-route-id="@item.Id">View details</a>
                        @if (!item.IsSystem)
                        {
                            <a class="btn btn-secondary btn-sm" asp-page="/Contracts/Types/Edit" asp-route-id="@item.Id">Edit</a>
                            @if (item.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" onsubmit="return confirm('Deactivate this type?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Deactivate</button>
                                </form>
                            }
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}

