@page "{id:guid}"
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.ViewModel
@{
    ViewData["Title"] = Model.TypeDefinition?.Name ?? "Data Type";
    var newVersionUrl = Model.TypeDefinition is null
        ? string.Empty
        : $"/buttermorph/schema-types/designer?context=type-version:new:{Model.TypeDefinition.Id}&mode=create&popup=true";
}

<section class="dashboard-section">
    <div class="platform-card event-detail-card">
        <div class="platform-card-header">
            <span>Data Type Details</span>
            <div class="d-flex gap-2">
                @if (Model.TypeDefinition is not null && !Model.TypeDefinition.IsSystem)
                {
                    <a class="btn btn-secondary btn-sm" asp-page="/Contracts/Types/Edit" asp-route-id="@Model.TypeDefinition.Id">Edit data type</a>
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-buttermorph-url="@newVersionUrl"
                            data-buttermorph-title="New version of @Model.TypeDefinition.Name"
                            data-buttermorph-redirect-url="@Url.Page("/Contracts/Types/View", new { id = Model.TypeDefinition.Id })">
                        <i class="bi bi-plus-lg"></i> New version
                    </button>
                }
                <a class="btn btn-secondary btn-sm" asp-page="/Contracts/Types/Index"><i class="bi bi-arrow-left"></i> Back</a>
            </div>
        </div>

        @if (Model.TypeDefinition is null)
        {
            <div class="events-empty-state"><h3>Data type not found</h3></div>
        }
        else
        {
            <div class="event-meta-grid">
                <div>
                    <span class="event-meta-label">Name</span>
                    <p class="event-meta-value">@Model.TypeDefinition.Name</p>
                </div>
                <div>
                    <span class="event-meta-label">Base type</span>
                    <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.SelectedDefinition.BaseType) ? "-" : Model.SelectedDefinition.BaseType)</p>
                </div>
                <div>
                    <span class="event-meta-label">Versions</span>
                    <p class="event-meta-value">@Model.TypeDefinition.Versions.Count</p>
                </div>
            </div>

            <div class="mt-3">
                <span class="event-meta-label">Description</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.TypeDefinition.Description) ? "-" : Model.TypeDefinition.Description)</p>
            </div>

            <div class="mt-3">
                <span class="event-meta-label">Available Versions</span>
                <div class="d-flex gap-2 flex-wrap mt-2">
                    @foreach (var ver in Model.TypeDefinition.Versions.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <a class="btn btn-secondary btn-sm @(Model.SelectedVersion?.Id == ver.Id ? "active" : "")"
                           asp-page="/Contracts/Types/View"
                           asp-route-id="@Model.TypeDefinition.Id"
                           asp-route-version="@ver.VersionNumber">
                            @ver.VersionNumber
                        </a>
                    }
                </div>
            </div>

            <div class="mt-3 event-detail-schema">
                <span class="event-meta-label">Schema (@Model.SelectedVersion?.VersionNumber)</span>
                <p class="event-meta-value"><strong>Comment:</strong> @(string.IsNullOrWhiteSpace(Model.SelectedVersion?.Comment) ? "-" : Model.SelectedVersion?.Comment)</p>
                <pre class="contract-json-output">@Model.FormattedJsonSchema</pre>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}

