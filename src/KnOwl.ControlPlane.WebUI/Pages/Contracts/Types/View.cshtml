@page "{id:guid}"
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.ViewModel
@{
    ViewData["Title"] = Model.TypeDefinition?.Name ?? "Data Type";
}

<section class="dashboard-section">
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.TypeDefinition?.Name</h1>
            <p class="od-page-subtitle">@(string.IsNullOrWhiteSpace(Model.TypeDefinition?.Key) ? "Data type" : Model.TypeDefinition.Key)</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Contracts/Types/Index">Back</a>
            @if (Model.TypeDefinition is not null && !Model.TypeDefinition.IsSystem)
            {
                <a class="btn btn-outline-secondary" asp-page="/Contracts/Types/Edit" asp-route-id="@Model.TypeDefinition.Id">Edit data type</a>
                <a class="btn btn-primary" asp-page="/Contracts/Types/NewVersion" asp-route-id="@Model.TypeDefinition.Id">New version</a>
            }
        </div>
    </div>

    @if (Model.TypeDefinition is null)
    {
        <section class="od-panel"><p class="od-empty">Data type not found.</p></section>
    }
    else
    {
        <section class="od-panel">
            <div class="contract-detail-summary">
                <div><span class="event-meta-label">Name</span><p class="event-meta-value">@Model.TypeDefinition.Name</p></div>
                <div><span class="event-meta-label">Key</span><p class="event-meta-value">@Model.TypeDefinition.Key</p></div>
                <div><span class="event-meta-label">Versions</span><p class="event-meta-value">@Model.TypeDefinition.Versions.Count</p></div>
            </div>
            <div class="mt-3">
                <span class="event-meta-label">Description</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.TypeDefinition.Description) ? "-" : Model.TypeDefinition.Description)</p>
            </div>
        </section>

        <section class="od-list-shell mt-3">
            <form method="get" class="od-search-bar od-search-bar-compact">
                <label class="od-search-field" for="type-versions-search">
                    <span>Search versions</span>
                    <input id="type-versions-search" name="search" value="@Model.Search" class="form-control" placeholder="Version, notes, schema, status" />
                </label>
                <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a class="btn btn-secondary" asp-page="/Contracts/Types/View" asp-route-id="@Model.TypeDefinition.Id">Clear</a>
                    <span class="od-search-count">@Model.Versions.Count of @Model.TypeDefinition.Versions.Count</span>
                }
            </form>

            @if (!Model.Versions.Any())
            {
                <p class="od-empty">@(string.IsNullOrWhiteSpace(Model.Search) ? "No versions yet." : "No versions match the current search.")</p>
            }
            else
            {
                <div class="od-grid od-versions-grid">
                    @foreach (var version in Model.Versions)
                    {
                        <article class="od-item-card od-version-card"
                                 data-open-url="@Url.Page("/Contracts/Types/Version", new { id = Model.TypeDefinition.Id, versionId = version.Id })">
                            <div class="od-item-top">
                                <div>
                                    <h2 class="od-item-title">@version.VersionNumber</h2>
                                    <p class="od-item-meta">@(string.IsNullOrWhiteSpace(version.Comment) ? "No version notes" : version.Comment)</p>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="od-status @(version.IsActive ? "od-status-active" : "od-status-inactive")">@(version.IsActive ? "Active" : "Inactive")</span>
                                    <div class="dropdown">
                                        <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Version actions">&#8942;</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-page="/Contracts/Types/Version" asp-route-id="@Model.TypeDefinition.Id" asp-route-versionId="@version.Id">Open</a>
                                            </li>
                                            @if (!Model.TypeDefinition.IsSystem && version.IsActive)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form method="post" asp-page-handler="DeactivateVersion" class="od-inline-form">
                                                        <input type="hidden" name="id" value="@Model.TypeDefinition.Id" />
                                                        <input type="hidden" name="versionId" value="@version.Id" />
                                                        <button type="submit" class="dropdown-item text-danger">Deactivate version</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="od-card-footer">
                                <span class="od-card-date">Created @version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>
