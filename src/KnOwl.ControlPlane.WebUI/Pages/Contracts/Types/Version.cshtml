@page "{id:guid}/versions/{versionId:guid}"
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Types.VersionModel
@{
    ViewData["Title"] = "Data Type Version";
}

<section class="dashboard-section">
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.TypeDefinition?.Name @Model.Version?.VersionNumber</h1>
            <p class="od-page-subtitle">Data type version details</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Contracts/Types/View" asp-route-id="@Model.TypeDefinition?.Id">Back</a>
            @if (Model.TypeDefinition is not null && !Model.TypeDefinition.IsSystem)
            {
                <a class="btn btn-outline-secondary" asp-page="/Contracts/Types/NewVersion" asp-route-id="@Model.TypeDefinition.Id">New version</a>
            }
        </div>
    </div>

    @if (Model.TypeDefinition is not null && Model.Version is not null)
    {
        <section class="od-panel">
            <div class="od-version-detail-head">
                <div>
                    <span class="od-status @(Model.Version.IsActive ? "od-status-active" : "od-status-inactive")">@(Model.Version.IsActive ? "Active" : "Inactive")</span>
                    <h2 class="od-section-title mt-2 mb-1">Version @Model.Version.VersionNumber</h2>
                    <p class="od-item-meta mb-0">Created @Model.Version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
                @if (!Model.TypeDefinition.IsSystem && Model.Version.IsActive)
                {
                    <form method="post" asp-page-handler="DeactivateVersion">
                        <input type="hidden" name="id" value="@Model.TypeDefinition.Id" />
                        <input type="hidden" name="versionId" value="@Model.Version.Id" />
                        <button type="submit" class="btn btn-outline-danger">Deactivate version</button>
                    </form>
                }
            </div>
            <div class="contract-detail-summary mt-3">
                <div><span class="event-meta-label">Base type</span><p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.SelectedDefinition.BaseType) ? "-" : Model.SelectedDefinition.BaseType)</p></div>
                <div><span class="event-meta-label">Notes</span><p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Version.Comment) ? "-" : Model.Version.Comment)</p></div>
            </div>
        </section>

        <details class="contract-schema-details mt-3" open>
            <summary>Schema</summary>
            <pre class="contract-json-output">@Model.FormattedJsonSchema</pre>
        </details>
    }
</section>
