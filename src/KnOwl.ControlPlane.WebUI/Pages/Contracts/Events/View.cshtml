@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Events.ViewModel
@using KnOwl.ControlPlane.Design.Core
@{
    ViewData["Title"] = "Event Details";
    var newVersionUrl = Model.Event is null
        ? string.Empty
        : $"/buttermorph/payload-schema/designer?context=event-version:new:{Model.Event.Id}&mode=edit&popup=true";

    string StatusClass(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.Draft => "knowl-status knowl-status-draft",
        ContractVersionStatus.InReview => "knowl-status knowl-status-review",
        ContractVersionStatus.Abandoned => "knowl-status knowl-status-abandoned",
        ContractVersionStatus.Approved => "knowl-status knowl-status-approved",
        ContractVersionStatus.Deployed => "knowl-status knowl-status-deployed",
        ContractVersionStatus.Deprecated => "knowl-status knowl-status-deprecated",
        ContractVersionStatus.Archived => "knowl-status knowl-status-archived",
        _ => "knowl-status"
    };

    string StatusLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "In review",
        ContractVersionStatus.Abandoned => "Abandoned",
        _ => status.ToString()
    };

    string ActionLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "Send to review",
        ContractVersionStatus.Abandoned => "Abandon draft",
        ContractVersionStatus.Draft => "Return to draft",
        ContractVersionStatus.Approved => "Approve version",
        ContractVersionStatus.Deployed => "Deploy version",
        ContractVersionStatus.Deprecated => "Deprecate version",
        ContractVersionStatus.Archived => "Archive version",
        _ => status.ToString()
    };
}

<section class="dashboard-section">
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.Event?.Name</h1>
            <p class="od-page-subtitle">@(string.IsNullOrWhiteSpace(Model.Event?.Topic) ? "Event" : Model.Event.Topic)</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Contracts/Events/Index">Back</a>
            @if (Model.Event is not null)
            {
                <a class="btn btn-outline-secondary" asp-page="/Contracts/Events/Edit" asp-route-id="@Model.Event.Id">Edit event</a>
                <button type="button"
                        class="btn btn-primary"
                        data-buttermorph-url="@newVersionUrl"
                        data-buttermorph-title="New version of @Model.Event.Name"
                        data-buttermorph-redirect-url="@Url.Page("/Contracts/Events/View", new { id = Model.Event.Id })">
                    New version
                </button>
            }
        </div>
    </div>

    @if (Model.Event is null)
    {
        <section class="od-panel"><p class="od-empty">Event not found.</p></section>
    }
    else
    {
        @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

        <section class="od-panel">
            <div class="contract-detail-summary">
                <div><span class="event-meta-label">Name</span><p class="event-meta-value">@Model.Event.Name</p></div>
                <div><span class="event-meta-label">Topic</span><p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Event.Topic) ? "-" : Model.Event.Topic)</p></div>
                <div><span class="event-meta-label">Versions</span><p class="event-meta-value">@Model.Event.Versions.Count</p></div>
            </div>
            <div class="mt-3">
                <span class="event-meta-label">Description</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Event.Description) ? "-" : Model.Event.Description)</p>
            </div>
        </section>

        <section class="od-list-shell mt-3">
            @if (!Model.Event.Versions.Any())
            {
                <p class="od-empty">No versions yet.</p>
            }
            else
            {
                <div class="od-grid od-versions-grid">
                    @foreach (var version in Model.Event.Versions.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <article class="od-item-card od-version-card"
                                 data-open-url="@Url.Page("/Contracts/Events/Version", new { id = Model.Event.Id, versionId = version.Id })">
                            <div class="od-item-top">
                                <div>
                                    <h2 class="od-item-title">@version.VersionNumber</h2>
                                    <p class="od-item-meta">@(string.IsNullOrWhiteSpace(version.Comment) ? "No version notes" : version.Comment)</p>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="@StatusClass(version.Status)">@StatusLabel(version.Status)</span>
                                    <div class="dropdown">
                                        <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Version actions">&#8942;</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-page="/Contracts/Events/Version" asp-route-id="@Model.Event.Id" asp-route-versionId="@version.Id">Open</a>
                                            </li>
                                            @if (version.Status == ContractVersionStatus.Draft)
                                            {
                                                var editDraftUrl = $"/buttermorph/payload-schema/designer?context={KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.EditEventVersion(version.Id)}&mode=edit&popup=true";
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            data-buttermorph-url="@editDraftUrl"
                                                            data-buttermorph-title="Edit event draft"
                                                            data-buttermorph-redirect-url="@Url.Page("/Contracts/Events/Version", new { id = Model.Event.Id, versionId = version.Id })">
                                                        Edit draft
                                                    </button>
                                                </li>
                                            }
                                            @foreach (var target in Model.GetAllowedTargets(version.Status))
                                            {
                                                <li>
                                                    <form method="post"
                                                          asp-page-handler="Transition"
                                                          class="od-inline-form"
                                                          data-status-transition-form
                                                          data-confirm-title="Confirm status change"
                                                          data-confirm-message="Change version @version.VersionNumber to @StatusLabel(target)?"
                                                          data-confirm-label="@ActionLabel(target)">
                                                        <input type="hidden" name="id" value="@Model.Event.Id" />
                                                        <input type="hidden" name="versionId" value="@version.Id" />
                                                        <input type="hidden" name="targetStatus" value="@target" />
                                                        <button type="submit" class="dropdown-item @(target is ContractVersionStatus.Abandoned or ContractVersionStatus.Archived ? "text-danger" : string.Empty)">@ActionLabel(target)</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="od-card-footer">
                                <span class="od-card-date">Created @version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}
