@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Events.IndexModel
@{
    ViewData["Title"] = "Events";
    var newEventUrl = $"/buttermorph/payload-schema/designer?context={KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.EventNew()}&mode=create&popup=true";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Events</h1>
        <p class="od-page-subtitle">Global events and their versioned payload schemas.</p>
    </div>
            <button type="button"
            class="btn btn-primary"
                    data-buttermorph-url="@newEventUrl"
                    data-buttermorph-title="New event"
                    data-buttermorph-event-create="true">
                <i class="bi bi-plus-lg"></i> New event
            </button>
</div>
        
        @if (Model.Events.Count == 0)
        {
            <section class="od-panel">
            <div class="events-empty-state">
                <i class="bi bi-inbox"></i>
                <h3>No saved events</h3>
                <p>Start by creating your first event contract.</p>
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-buttermorph-url="@newEventUrl"
                        data-buttermorph-title="New event"
                        data-buttermorph-event-create="true">
                    Add event
                </button>
            </div>
            </section>
        }
        else
        {
            <section class="od-list-shell">
            <div class="od-grid">
                @foreach (var item in Model.Events)
                {
                    <article class="od-item-card"
                             data-open-url="@Url.Page("/Contracts/Events/View", new { id = item.Id })">
                        <div class="od-item-top">
                            <div>
                                <h2 class="od-item-title">@item.Name</h2>
                            </div>
                            <div class="d-flex align-items-start gap-2">
                                <span class="od-status @(item.IsActive ? "od-status-active" : "od-status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span>
                                <div class="dropdown">
                                    <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Event actions">&#8942;</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-page="/Contracts/Events/View" asp-route-id="@item.Id">Open</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="/Contracts/Events/Edit" asp-route-id="@item.Id">Edit</a>
                                        </li>
                                        @if (item.IsActive)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="od-inline-form" onsubmit="return confirm('Deactivate this event? Existing versions and artifacts will be preserved.');">
                                                    <button type="submit" class="dropdown-item text-danger">Deactivate</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                        <div class="od-card-footer">
                            <span class="od-card-date">Created @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                        </div>
                    </article>
                }
            </div>
            </section>
        }

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}


