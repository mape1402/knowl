@page "{id:guid}/versions/{versionId:guid}"
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Events.VersionModel
@using KnOwl.ControlPlane.Design.Core
@{
    ViewData["Title"] = "Event Version";

    string StatusClass(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.Draft => "knowl-status knowl-status-draft",
        ContractVersionStatus.InReview => "knowl-status knowl-status-review",
        ContractVersionStatus.Abandoned => "knowl-status knowl-status-abandoned",
        ContractVersionStatus.Approved => "knowl-status knowl-status-approved",
        ContractVersionStatus.Deployed => "knowl-status knowl-status-deployed",
        ContractVersionStatus.Deprecated => "knowl-status knowl-status-deprecated",
        ContractVersionStatus.Archived => "knowl-status knowl-status-archived",
        _ => "knowl-status"
    };

    string StatusLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "In review",
        ContractVersionStatus.Abandoned => "Abandoned",
        _ => status.ToString()
    };

    string ActionLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "Send to review",
        ContractVersionStatus.Abandoned => "Abandon draft",
        ContractVersionStatus.Draft => "Return to draft",
        ContractVersionStatus.Approved => "Approve version",
        ContractVersionStatus.Deployed => "Deploy version",
        ContractVersionStatus.Deprecated => "Deprecate version",
        ContractVersionStatus.Archived => "Archive version",
        _ => status.ToString()
    };
}

<section class="dashboard-section">
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.Event?.Name @Model.Version?.VersionNumber</h1>
            <p class="od-page-subtitle">Event version details</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Contracts/Events/View" asp-route-id="@Model.Event?.Id">Back</a>
            @if (Model.Event is not null && Model.Version?.Status == ContractVersionStatus.Draft)
            {
                var editUrl = $"/buttermorph/payload-schema/designer?context={KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.EditEventVersion(Model.Version.Id)}&mode=edit&popup=true";
                <button type="button"
                        class="btn btn-primary"
                        data-buttermorph-url="@editUrl"
                        data-buttermorph-title="Edit event draft"
                        data-buttermorph-redirect-url="@Url.Page("/Contracts/Events/Version", new { id = Model.Event.Id, versionId = Model.Version.Id })">
                    Edit draft
                </button>
            }
        </div>
    </div>

    @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

    @if (Model.Event is not null && Model.Version is not null)
    {
        <section class="od-panel">
            <div class="od-version-detail-head">
                <div>
                    <span class="@StatusClass(Model.Version.Status)">@StatusLabel(Model.Version.Status)</span>
                    <h2 class="od-section-title mt-2 mb-1">Version @Model.Version.VersionNumber</h2>
                    <p class="od-item-meta mb-0">Created @Model.Version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Actions</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var target in Model.AllowedTargets)
                        {
                            <li>
                                <form method="post"
                                      asp-page-handler="Transition"
                                      class="od-inline-form"
                                      data-status-transition-form
                                      data-confirm-title="Confirm status change"
                                      data-confirm-message="Change version @Model.Version.VersionNumber to @StatusLabel(target)?"
                                      data-confirm-label="@ActionLabel(target)">
                                    <input type="hidden" name="id" value="@Model.Event.Id" />
                                    <input type="hidden" name="versionId" value="@Model.Version.Id" />
                                    <input type="hidden" name="targetStatus" value="@target" />
                                    <button type="submit" class="dropdown-item @(target is ContractVersionStatus.Abandoned or ContractVersionStatus.Archived ? "text-danger" : string.Empty)">@ActionLabel(target)</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="mt-3">
                <span class="event-meta-label">Notes</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Version.Comment) ? "-" : Model.Version.Comment)</p>
            </div>
        </section>

        <details class="contract-schema-details mt-3" open>
            <summary>Payload schema</summary>
            <pre class="contract-json-output">@Model.FormattedPayloadSchemaJson</pre>
        </details>
    }
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}
