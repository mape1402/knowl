@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.TypeMappings.IndexModel
@{
    ViewData["Title"] = "Type Mappings";
    var newMappingUrl = "/buttermorph/language-type-mappings/designer?mode=create&popup=true";
}

<div class="od-page-head">
    <div>
        <h1 class="od-page-title">Type Mappings</h1>
        <p class="od-page-subtitle">Language type mapping packages used by ButterMorph code viewers.</p>
    </div>
    <button type="button"
            class="btn btn-primary"
            data-buttermorph-url="@newMappingUrl"
            data-buttermorph-title="New type mapping">
        <i class="bi bi-plus-lg"></i> New type mapping
    </button>
</div>

<form method="get" class="od-search-bar">
    <label class="od-search-field" for="type-mappings-search">
        <span>Search type mappings</span>
        <input id="type-mappings-search" name="search" value="@Model.Search" class="form-control" placeholder="Name, key, language, description, status" />
    </label>
    <button type="submit" class="btn btn-secondary"><i class="bi bi-search"></i> Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn btn-secondary" asp-page="/Contracts/TypeMappings/Index">Clear</a>
        <span class="od-search-count">@Model.Items.Count of @Model.TotalItems</span>
    }
</form>

@Html.AntiForgeryToken()

<section class="od-list-shell">
    @if (Model.Items.Count == 0)
    {
        <p class="od-empty">@(string.IsNullOrWhiteSpace(Model.Search) ? "No type mappings found." : "No type mappings match the current search.")</p>
    }
    else
    {
        <div class="od-grid">
            @foreach (var item in Model.Items)
            {
                var editUrl = $"/buttermorph/language-type-mappings/designer?context={Uri.EscapeDataString(item.Key)}&mode=edit&popup=true";
                <article class="od-item-card"
                         data-type-mapping-open-url="@editUrl"
                         data-type-mapping-title="Edit @item.Name">
                    <div class="od-item-top">
                        <div>
                            <h2 class="od-item-title">@item.Name</h2>
                            <p class="od-item-meta">@item.Key</p>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <span class="od-status @(item.IsActive ? "od-status-active" : "od-status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span>
                            <div class="dropdown">
                                <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Type mapping actions">&#8942;</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item"
                                                data-buttermorph-url="@editUrl"
                                                data-buttermorph-title="Edit @item.Name">
                                            Open
                                        </button>
                                    </li>
                                    @if (item.IsActive)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form method="post" asp-page-handler="Deactivate" asp-route-id="@item.Id" class="od-inline-form" data-status-transition-form data-confirm-title="Deactivate type mapping" data-confirm-message="Deactivate @item.Name?" data-confirm-label="Deactivate">
                                                <button type="submit" class="dropdown-item text-danger">Deactivate</button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <p class="od-item-description">@(string.IsNullOrWhiteSpace(item.Description) ? "No description." : item.Description)</p>
                    <div class="od-card-footer">
                        <span>@item.LanguageKey</span>
                        <span>Updated @item.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
    <script>
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            document.querySelectorAll("[data-type-mapping-open-url]").forEach(card => {
                card.addEventListener("click", event => {
                    if (event.target.closest("a, button, input, textarea, select, label, form, .dropdown, .dropdown-menu")) {
                        return;
                    }

                    const url = card.getAttribute("data-type-mapping-open-url");
                    if (!url) {
                        return;
                    }

                    window.ButterMorphHost?.openFrame(url, {
                        title: card.getAttribute("data-type-mapping-title") || "Type mapping",
                        width: 1280,
                        height: 840
                    });
                });
            });

            window.addEventListener("message", async event => {
                if (event.origin !== window.location.origin || !event.data || event.data.type !== "ButterMorphLanguageTypeMappingsSaved") {
                    return;
                }

                const response = await fetch("@Url.Page("/Contracts/TypeMappings/Index", "SaveDocument")", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify(event.data.document || {})
                });

                if (response.ok) {
                    window.location.reload();
                }
            });
        })();
    </script>
}
