@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Commands.ViewModel
@using KnOwl.ControlPlane.Design.Core
@{
    ViewData["Title"] = "Command Details";

    string StatusClass(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.Draft => "knowl-status knowl-status-draft",
        ContractVersionStatus.InReview => "knowl-status knowl-status-review",
        ContractVersionStatus.Abandoned => "knowl-status knowl-status-abandoned",
        ContractVersionStatus.Approved => "knowl-status knowl-status-approved",
        ContractVersionStatus.Deployed => "knowl-status knowl-status-deployed",
        ContractVersionStatus.Deprecated => "knowl-status knowl-status-deprecated",
        ContractVersionStatus.Archived => "knowl-status knowl-status-archived",
        _ => "knowl-status"
    };

    string StatusLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "In review",
        ContractVersionStatus.Abandoned => "Abandoned",
        _ => status.ToString()
    };

    string ActionLabel(ContractVersionStatus status) => status switch
    {
        ContractVersionStatus.InReview => "Send to review",
        ContractVersionStatus.Abandoned => "Abandon draft",
        ContractVersionStatus.Draft => "Return to draft",
        ContractVersionStatus.Approved => "Approve version",
        ContractVersionStatus.Deployed => "Deploy version",
        ContractVersionStatus.Deprecated => "Deprecate version",
        ContractVersionStatus.Archived => "Archive version",
        _ => status.ToString()
    };
}

<section class="dashboard-section">
    <div class="od-page-head">
        <div>
            <h1 class="od-page-title">@Model.Command?.Name</h1>
            <p class="od-page-subtitle">@(string.IsNullOrWhiteSpace(Model.Command?.Topic) ? "Command" : Model.Command.Topic)</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="/Contracts/Commands/Index">Back</a>
            @if (Model.Command is not null)
            {
                <a class="btn btn-outline-secondary" asp-page="/Contracts/Commands/Edit" asp-route-id="@Model.Command.Id">Edit command</a>
                <a class="btn btn-primary" asp-page="/Contracts/Commands/NewVersion" asp-route-id="@Model.Command.Id">New version</a>
            }
        </div>
    </div>

    @if (Model.Command is null)
    {
        <section class="od-panel"><p class="od-empty">Command not found.</p></section>
    }
    else
    {
        @await Html.PartialAsync("_StatusMessageBox", Model.StatusMessage)

        <section class="od-panel">
            <div class="contract-detail-summary">
                <div><span class="event-meta-label">Name</span><p class="event-meta-value">@Model.Command.Name</p></div>
                <div><span class="event-meta-label">Topic</span><p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Command.Topic) ? "-" : Model.Command.Topic)</p></div>
                <div><span class="event-meta-label">Versions</span><p class="event-meta-value">@Model.Command.Versions.Count</p></div>
            </div>
            <div class="mt-3">
                <span class="event-meta-label">Description</span>
                <p class="event-meta-value">@(string.IsNullOrWhiteSpace(Model.Command.Description) ? "-" : Model.Command.Description)</p>
            </div>
        </section>

        <section class="od-list-shell mt-3">
            @if (!Model.Command.Versions.Any())
            {
                <p class="od-empty">No versions yet.</p>
            }
            else
            {
                <div class="od-grid od-versions-grid">
                    @foreach (var version in Model.Command.Versions.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <article class="od-item-card od-version-card"
                                 data-open-url="@Url.Page("/Contracts/Commands/Version", new { id = Model.Command.Id, versionId = version.Id })">
                            <div class="od-item-top">
                                <div>
                                    <h2 class="od-item-title">@version.VersionNumber</h2>
                                    <p class="od-item-meta">@(string.IsNullOrWhiteSpace(version.Comment) ? "No version notes" : version.Comment)</p>
                                </div>
                                <div class="d-flex align-items-start gap-2">
                                    <span class="@StatusClass(version.Status)">@StatusLabel(version.Status)</span>
                                    <div class="dropdown">
                                        <button class="od-kebab" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Version actions">&#8942;</button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-page="/Contracts/Commands/Version" asp-route-id="@Model.Command.Id" asp-route-versionId="@version.Id">Open</a>
                                            </li>
                                            @if (version.Status == ContractVersionStatus.Draft)
                                            {
                                                var editRequestUrl = $"/buttermorph/payload-schema/designer?context={KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.EditCommandVersionRequest(version.Id)}&mode=edit&popup=true";
                                                var editReplyUrl = $"/buttermorph/payload-schema/designer?context={KnOwl.ControlPlane.WebUI.ButterMorph.KnOwlButterMorphContext.EditCommandVersionReply(version.Id)}&mode=edit&popup=true";
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            data-buttermorph-url="@editRequestUrl"
                                                            data-buttermorph-title="Edit command request draft"
                                                            data-buttermorph-redirect-url="@Url.Page("/Contracts/Commands/Version", new { id = Model.Command.Id, versionId = version.Id })">
                                                        Edit request
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button"
                                                            class="dropdown-item"
                                                            data-buttermorph-url="@editReplyUrl"
                                                            data-buttermorph-title="Edit command reply draft"
                                                            data-buttermorph-redirect-url="@Url.Page("/Contracts/Commands/Version", new { id = Model.Command.Id, versionId = version.Id })">
                                                        Edit reply
                                                    </button>
                                                </li>
                                            }
                                            @foreach (var target in Model.GetAllowedTargets(version.Status))
                                            {
                                                <li>
                                                    <form method="post" asp-page-handler="Transition" class="od-inline-form">
                                                        <input type="hidden" name="id" value="@Model.Command.Id" />
                                                        <input type="hidden" name="versionId" value="@version.Id" />
                                                        <input type="hidden" name="targetStatus" value="@target" />
                                                        <button type="submit" class="dropdown-item @(target is ContractVersionStatus.Abandoned or ContractVersionStatus.Archived ? "text-danger" : string.Empty)">@ActionLabel(target)</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="od-card-footer">
                                <span class="od-card-date">Created @version.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</section>
