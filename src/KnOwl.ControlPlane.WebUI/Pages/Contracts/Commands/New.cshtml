@page
@model KnOwl.ControlPlane.WebUI.Pages.Contracts.Commands.NewModel
@{
    ViewData["Title"] = "New Command";
    var designerUrl = $"/buttermorph/payload-schema/designer?context={Model.ButterMorphContext}&mode=edit&popup=true";
    var replyDesignerUrl = $"/buttermorph/payload-schema/designer?context={Model.ReplyButterMorphContext}&mode=edit&popup=true";
}

<section class="dashboard-section">
    <div class="platform-card event-editor">
        <div class="platform-card-header">
            <span>New command</span>
            <div class="event-list-actions">
                <a class="btn btn-secondary btn-sm" asp-page="/Contracts/Commands/Index">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>

        <form id="event-editor-form" method="post">
            <div asp-validation-summary="ModelOnly" class="knowl-message-box knowl-message-danger"></div>
            <input asp-for="DraftId" type="hidden" />
            <input asp-for="PayloadSchemaJson" type="hidden" id="payload-schema-json" />
            <input asp-for="ReplyPayloadSchemaJson" type="hidden" id="reply-payload-schema-json" />

            <div class="contract-editor-scroll">
                <div class="event-schema-block">
                    <div class="event-schema-header">
                        <div>
                            <h2 class="section-heading event-schema-title">Command request</h2>
                            <small class="text-muted" data-buttermorph-payload-status>Name, topic, description, and version are taken from this schema.</small>
                        </div>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                data-buttermorph-url="@designerUrl"
                                data-buttermorph-title="Command request schema"
                                data-buttermorph-payload-context="@Model.ButterMorphContext"
                                data-buttermorph-payload-target="payload-schema-json">
                            <i class="bi bi-box-arrow-up-right"></i> Design request
                        </button>
                    </div>
                </div>

                <div class="event-schema-block">
                    <div class="event-schema-header">
                        <div>
                            <h2 class="section-heading event-schema-title">Command reply</h2>
                            <small class="text-muted" data-buttermorph-payload-status>The reply schema is optional for this version.</small>
                        </div>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                data-buttermorph-url="@replyDesignerUrl"
                                data-buttermorph-title="Command reply schema"
                                data-buttermorph-payload-context="@Model.ReplyButterMorphContext"
                                data-buttermorph-payload-target="reply-payload-schema-json">
                            <i class="bi bi-box-arrow-up-right"></i> Design reply
                        </button>
                    </div>
                </div>
            </div>

            <div class="event-editor-actions contract-editor-actions mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Create command</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/_content/ButterMorph.Web.Razor/buttermorph/buttermorph-host.js"></script>
    <script src="~/_content/KnOwl.ControlPlane.WebUI/js/buttermorph-knowl-host.js" asp-append-version="true"></script>
}
