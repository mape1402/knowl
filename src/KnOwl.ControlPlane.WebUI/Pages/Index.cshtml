@page
@model IndexModel
@inject Microsoft.Extensions.Options.IOptions<KnOwl.ControlPlane.WebUI.KnOwlControlPlaneThemeOptions> ThemeOptions
@{
    var appTitle = string.IsNullOrWhiteSpace(ThemeOptions.Value.Title) ? "KnOwl" : ThemeOptions.Value.Title;
    var homeTitle = string.IsNullOrWhiteSpace(Model.Home.Title) ? appTitle : Model.Home.Title;
    ViewData["Title"] = "Home";
}

<!-- ── Hero ──────────────────────────────────────────── -->
<section class="hero-banner">
    <div class="hero-content">
        <h1 class="hero-title">
            <i class="bi bi-hexagon-fill hero-icon"></i>
            @homeTitle
        </h1>
        <p class="hero-subtitle">
            @Model.Home.Subtitle
        </p>
    </div>
</section>

<!-- ── Quick access ─────────────────────────────────── -->
@if (Model.Home.ShowQuickAccess && Model.Home.QuickAccessCards.Count > 0)
{
    <section class="dashboard-section">
        <h2 class="section-heading">Quick Access</h2>
        <div class="hub-grid">
            @foreach (var card in Model.Home.QuickAccessCards)
            {
                <a href="@card.Url" class="hub-card">
                    <div class="hub-card-icon" style="--hc-accent: @card.AccentColor;">
                        <i class="bi bi-@card.Icon"></i>
                    </div>
                    <div class="hub-card-body">
                        <h3 class="hub-card-title">@card.Title</h3>
                        <p class="hub-card-desc">@card.Description</p>
                    </div>
                    <span class="hub-card-arrow"><i class="bi bi-arrow-right"></i></span>
                </a>
            }
        </div>
    </section>
}

<!-- ── Overview ──────────────────────────────────────── -->
@if (Model.Home.ShowOverview && Model.Home.OverviewCards.Count > 0)
{
    <section class="dashboard-section">
        <h2 class="section-heading">Platform Overview</h2>
        <div class="stats-grid">
            @foreach (var card in Model.Home.OverviewCards)
            {
                <div class="stat-card">
                    <span class="stat-value">@card.Value</span>
                    <span class="stat-label">@card.Label</span>
                </div>
            }
        </div>
    </section>
}

<!-- ── Getting started ──────────────────────────────── -->
@if (Model.Home.ShowGettingStarted && Model.Home.GettingStartedItems.Count > 0)
{
    <section class="dashboard-section">
        <h2 class="section-heading">Getting Started</h2>
        <div class="platform-card">
            <ol class="getting-started-list">
                @foreach (var item in Model.Home.GettingStartedItems)
                {
                    <li>@Html.Raw(item)</li>
                }
            </ol>
        </div>
    </section>
}

