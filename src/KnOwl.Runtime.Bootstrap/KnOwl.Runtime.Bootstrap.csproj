<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnOwl.Runtime.Api\KnOwl.Runtime.Api.csproj" />
    <ProjectReference Include="..\KnOwl.Runtime.Application\KnOwl.Runtime.Application.csproj" />
    <ProjectReference Include="..\KnOwl.Runtime.Storage.EntityFramework\KnOwl.Runtime.Storage.EntityFramework.csproj" />
    <ProjectReference Include="..\KnOwl.Runtime.WebUI\KnOwl.Runtime.WebUI.csproj" />
    <ProjectReference Include="..\KnOwl.Security\KnOwl.Security.csproj" />
    <ProjectReference Include="..\KnOwl.Security.Storage.EntityFramework\KnOwl.Security.Storage.EntityFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\knowl_runtime_contracts.proto" GrpcServices="Server" />
  </ItemGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KnOwl.Runtime.Bootstrap</PackageId>
    <Title>KnOwl Runtime Bootstrap</Title>
    <Description>Reusable ASP.NET Core bootstrap composition for KnOwl runtime hosts.</Description>
  </PropertyGroup>

</Project>
